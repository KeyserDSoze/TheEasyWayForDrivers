<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <VersionPrefix>0.0.1</VersionPrefix>
    <Product>OmegaDrive Driver Manager</Product>
    <Company>OmegaDrive</Company>
    <Description>Windows driver inventory, update and OEM routing utility.</Description>
    <Copyright>Copyright © OmegaDrive</Copyright>
  </PropertyGroup>
</Project>
