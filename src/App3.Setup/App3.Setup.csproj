<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Embedded ZIP byte-integrity release gate relies on uncompressed
         PublishSingleFile managed bundle entries. Do not change without
         implementing a reader for compressed single-file resources. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <AssemblyName>App3.Setup</AssemblyName>
    <RootNamespace>TheEasyWayForDrivers.Setup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Shared.Core/Shared.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(PayloadZip)' != '' and Exists('$(PayloadZip)')">
    <EmbeddedResource Include="$(PayloadZip)"
                      LogicalName="TheEasyWayForDrivers.Payload.zip" />
  </ItemGroup>
</Project>
