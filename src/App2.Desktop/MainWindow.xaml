<Window x:Class="TheEasyWayForDrivers.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmegaDrive — Driver Manager"
        Icon="Assets/App.ico"
        Width="1180"
        Height="780"
        MinWidth="880"
        MinHeight="610"
        Background="#F2F6FC"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <!-- Shared visual language. One rounded, accessible template for both actions. -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1463B8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#1463B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#F59E0B" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.44" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#253654" />
            <Setter Property="BorderBrush" Value="#CBD8E8" />
            <Setter Property="Padding" Value="12,8" />
        </Style>

        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DDE7F3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="RowHeight" Value="38" />
            <Setter Property="ColumnHeaderHeight" Value="40" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0" />
            <Setter Property="SelectionMode" Value="Single" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#F9FBFF" BorderBrush="#DAE7F7"
                BorderThickness="1"
                CornerRadius="16"
                Padding="18,12"
                Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right"
                            HorizontalAlignment="Right">
                    <TextBlock x:Name="AppVersionText"
                               Foreground="#475569"
                               HorizontalAlignment="Right"
                               Text="App 0.0.0" />
                    <TextBlock x:Name="HeaderServiceText"
                               Foreground="#64748B"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,0"
                               Text="Servizio: verifica in corso..." />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Border Width="58"
                            Height="58"
                            Background="#EFF6FF"
                            CornerRadius="14"
                            Margin="0,0,14,0">
                        <Image Source="Assets/App.ico"
                               Width="46"
                               Height="46"
                               Stretch="Uniform" />
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="OmegaDrive"
                                   Foreground="#0F172A"
                                   FontSize="24"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Trova driver Windows e verifica i produttori"
                                   Foreground="#64748B"
                                   FontSize="12"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Solo il percorso guidato e visibile al primo avvio. -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
            <Button x:Name="AdvancedToggleButton"
                    Style="{StaticResource SecondaryButton}"
                    Content="Dettagli avanzati"
                    AutomationProperties.Name="Apri gli strumenti avanzati"
                    Click="AdvancedToggleButton_Click" />
            <WrapPanel x:Name="AdvancedActionsPanel" Visibility="Collapsed">
                <Button x:Name="ProblemsButton" Style="{StaticResource SecondaryButton}"
                        Content="Problemi hardware" Click="ProblemsButton_Click" />
                <Button x:Name="ScanButton" Style="{StaticResource SecondaryButton}"
                        Content="Scansiona dispositivi" Click="ScanButton_Click" />
                <Button x:Name="SearchUpdatesButton" Style="{StaticResource SecondaryButton}"
                        Content="Cerca driver" Click="SearchUpdatesButton_Click" />
                <ComboBox x:Name="DriverSearchModeComboBox"
                          Width="205" Height="36" Margin="0,0,8,8"
                          SelectedValuePath="Tag"
                          ToolTip="La ricerca approfondita include risultati avanzati che non vengono preselezionati.">
                    <ComboBoxItem Content="Ricerca consigliata" Tag="Recommended" />
                    <ComboBoxItem Content="Ricerca approfondita" Tag="Comprehensive" />
                </ComboBox>
                <Button x:Name="CheckAppUpdateButton" Style="{StaticResource SecondaryButton}"
                        Content="Controlla app" Click="CheckAppUpdateButton_Click" />
            </WrapPanel>
            <Button x:Name="ApplyAppUpdateButton" Style="{StaticResource PrimaryButton}"
                    Content="Aggiorna OmegaDrive" Visibility="Collapsed"
                    Click="ApplyAppUpdateButton_Click" />
            <Button x:Name="RebootButton" Style="{StaticResource PrimaryButton}"
                    Content="Riavvia Windows" Visibility="Collapsed"
                    Click="RebootButton_Click" />
        </WrapPanel>

        <Grid x:Name="SummaryGrid"
              Grid.Row="2"
              Visibility="Collapsed"
              Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <TextBlock Text="DISPOSITIVI"
                               Foreground="#64748B"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="DevicesCountText"
                               Text="—"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               Margin="0,5,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <TextBlock Text="DA CONTROLLARE"
                               Foreground="#64748B"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="AttentionCountText"
                               Text="—"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               Margin="0,5,0,0" />
                    <TextBlock x:Name="AttentionBreakdownText"
                               Text="Scansione non eseguita"
                               FontSize="11"
                               Foreground="#64748B"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <TextBlock Text="UPDATE DRIVER"
                               Foreground="#64748B"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="UpdatesCountText"
                               Text="—"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               Margin="0,5,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="SERVIZIO"
                               Foreground="#64748B"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ServiceHealthText"
                               Text="Verifica..."
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               Margin="0,5,0,0" />
                    <TextBlock x:Name="ServiceVersionCardText"
                               Text=""
                               Foreground="#64748B"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Single-action Home with an honest, visible scan state. -->
        <ScrollViewer x:Name="HomePanel" Grid.Row="3"
                      VerticalScrollBarVisibility="Auto">
            <Border MaxWidth="920" HorizontalAlignment="Center"
                    Margin="14,24,14,16" Padding="36"
                    BorderBrush="#DAE7F7" BorderThickness="1"
                    CornerRadius="22">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#EAF3FF" Offset="0" />
                        <GradientStop Color="#FFFFFF" Offset="0.80" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <Border Background="#DDEBFF" CornerRadius="8"
                            HorizontalAlignment="Left" Padding="10,6"
                            Margin="0,0,0,18">
                        <TextBlock Text="OMEGADRIVE  ·  CONTROLLO DRIVER"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#1456A0" />
                    </Border>
                    <TextBlock Text="Il tuo PC, sotto controllo"
                               Foreground="#14233F" FontSize="34"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="Scopri i driver proposti da Windows e verifica le fonti ufficiali dei produttori, senza perdere tempo tra le schermate."
                               Foreground="#475569" FontSize="16"
                               Margin="0,12,0,26" TextWrapping="Wrap" />
                    <Button x:Name="ScanAllButton"
                            Style="{StaticResource PrimaryButton}"
                            Content="Analizza il PC"
                            Padding="28,16" MinWidth="250" MinHeight="60"
                            FontSize="19" HorizontalAlignment="Left"
                            AutomationProperties.Name="Analizza il PC e cerca aggiornamenti driver"
                            Click="ScanAllButton_Click" />
                    <ProgressBar x:Name="HomeScanProgressBar"
                                 Visibility="Collapsed" IsIndeterminate="True"
                                 Height="5" Margin="0,12,0,0"
                                 Foreground="#1463B8" Background="#D9E7F8"
                                 AutomationProperties.Name="Analisi del PC in corso" />
                    <TextBlock x:Name="HomeScanStateText"
                               Text="Pronto per il controllo."
                               Margin="0,15,0,0" Foreground="#334155"
                               AutomationProperties.LiveSetting="Polite"
                               TextWrapping="Wrap" />
                    <Border Background="#F1F6FD" CornerRadius="10"
                            Padding="12,10" Margin="0,19,0,0">
                        <TextBlock Text="L'analisi è in sola lettura: nessun driver viene installato. Sceglierai tu se e cosa aggiornare."
                                   FontSize="12" Foreground="#435672"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Results are a first-class page, not an invitation to navigate
             eight technical tabs. Virtualized list and persistent footer. -->
        <Grid x:Name="HomeResultsPanel" Grid.Row="3" Visibility="Collapsed"
              Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#F9FBFF"
                    BorderBrush="#D8E5F6" BorderThickness="1"
                    CornerRadius="16" Padding="18,13" Margin="0,0,0,8">
                <DockPanel LastChildFill="True">
                    <Button x:Name="ResultsRescanButton" DockPanel.Dock="Right"
                            Style="{StaticResource SecondaryButton}"
                            Content="Nuova analisi" HorizontalAlignment="Right"
                            AutomationProperties.Name="Ripeti la ricerca dei driver"
                            Click="ScanAllButton_Click" />
                    <StackPanel>
                        <TextBlock Text="RISULTATI DEL CONTROLLO"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="#1463B8" Margin="0,0,0,4" />
                        <TextBlock x:Name="HomeResultHeadline"
                                   Text="Risultati dell'analisi"
                                   Foreground="#14233F" FontSize="23"
                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="HomeResultSummary"
                                   Foreground="#475569" Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="HomeSourceSummary"
                                   Foreground="#526783" Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="HomeCaveatText"
                                   FontSize="12" Foreground="#526783" Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="HomeCachedWuaSourceText"
                                   Visibility="Collapsed" FontSize="11"
                                   Foreground="#825923" Margin="0,5,0,0"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Titoli storici nella cache Windows, non installabili" />
                        <!-- Hardware classification is NOT an update offer. -->
                        <DockPanel Margin="0,12,0,5" LastChildFill="True">
                            <Button x:Name="HomeCoverageDetailsButton"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Dettagli delle fonti"
                                    Margin="8,0,0,0" MinHeight="32"
                                    AutomationProperties.Name="Mostra copertura dei driver e fonti ufficiali"
                                    Click="HomeCoverageDetailsButton_Click" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="COPERTURA HARDWARE E WINDOWS"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="#1456A0" />
                                <TextBlock Text="Dispositivi rilevati e driver offerti sono cose diverse."
                                           FontSize="11" Foreground="#526783"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl x:Name="HomeVendorCoverageCards"
                                      ItemsSource="{Binding HomeVendorCoverageRows}"
                                      AutomationProperties.Name="Copertura NVIDIA Intel Killer e Realtek">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White"
                                            BorderBrush="#DDE7F3" BorderThickness="1"
                                            CornerRadius="9" Padding="10,8"
                                            Margin="0,0,7,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Group}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#14233F" FontSize="13" />
                                            <TextBlock Text="{Binding DeviceStatus}"
                                                       FontSize="11" Foreground="#526783"
                                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding WindowsStatus}"
                                                       FontSize="11" Foreground="#145DA0"
                                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Le fonti OEM non sono interrogate automaticamente. Apri Dettagli delle fonti per controllare i produttori."
                                   FontSize="11" Foreground="#64748B"
                                   Margin="0,7,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Background="White"
                    BorderBrush="#DDE7F3" BorderThickness="1"
                    CornerRadius="12" Padding="12,9" Margin="0,0,0,8">
                <DockPanel LastChildFill="True">
                    <ComboBox x:Name="ResultFilterComboBox"
                              DockPanel.Dock="Right" Width="196" Height="38"
                              Background="#F8FBFF" Foreground="#14233F"
                              SelectedValuePath="Tag"
                              AutomationProperties.Name="Filtra aggiornamenti"
                              SelectionChanged="ResultFilterComboBox_SelectionChanged">
                        <ComboBoxItem Tag="all" Content="Tutti i risultati" />
                        <ComboBoxItem Tag="normal" Content="Aggiornabili" />
                        <ComboBoxItem Tag="recommended" Content="Consigliati" />
                        <ComboBoxItem Tag="optional" Content="Facoltativi" />
                        <ComboBoxItem Tag="advanced" Content="Avanzati / nascosti" />
                    </ComboBox>
                    <!-- Search is local only. Does not query OEM services or hardware IDs. -->
                    <Grid DockPanel.Dock="Right" Width="216" Height="38"
                          Margin="0,0,10,0">
                        <TextBox x:Name="CompactSearchTextBox"
                                 Background="#F8FBFF" Foreground="#14233F"
                                 BorderBrush="#CBD8E8" BorderThickness="1"
                                 Padding="11,7" FontSize="13"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.Name="Cerca nei risultati per nome, produttore o fonte"
                                 ToolTip="Cerca per nome del driver, produttore, modello o fonte Windows Update"
                                 TextChanged="CompactSearchTextBox_TextChanged" />
                        <TextBlock Text="Cerca nei risultati..."
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   FontSize="13" Foreground="#64748B"
                                   ToolTip="Suggerimento: inserisci il nome del driver">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=CompactSearchTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Driver individuati da Windows"
                                   Foreground="#0F172A" FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="CompactUpdateCountText"
                                   Foreground="#0F6CBD" FontSize="16"
                                   FontWeight="SemiBold" Margin="10,0,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Grid.Row="2" Background="White" CornerRadius="10"
                    BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <ListView x:Name="CompactUpdatesList"
                              ItemsSource="{Binding CompactUpdatesView}"
                              BorderThickness="0" Background="Transparent"
                              HorizontalContentAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              AutomationProperties.Name="Risultati della ricerca driver">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F5F9FF" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EAF3FF" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E3EAF4"
                                        BorderThickness="0,0,0,1"
                                        Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="35" />
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanQuickInstall}"
                                                  AutomationProperties.Name="Seleziona aggiornamento" />
                                        <Border Grid.Column="1" Width="36" Height="36"
                                                VerticalAlignment="Center" Background="#EFF6FF"
                                                CornerRadius="8">
                                            <TextBlock Text="WU" Foreground="#1463B8"
                                                       FontWeight="SemiBold" FontSize="13"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="2" Margin="12,0,14,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="#0F172A"
                                                       TextWrapping="Wrap" />
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#EAF3FF"
                                                        CornerRadius="6" Padding="7,3">
                                                    <TextBlock Text="{Binding KindText}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="#155AA3" />
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding CompactMetadata}"
                                                           ToolTip="{Binding CompactMetadata}"
                                                           FontSize="12" Foreground="#64748B"
                                                           Margin="9,0,0,0"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                            <TextBlock Text="{Binding CompactVersionSummary}"
                                                       FontSize="12" Foreground="#475569"
                                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="3"
                                                Content="{Binding QuickInstallLabel}"
                                                Style="{StaticResource SecondaryButton}"
                                                VerticalAlignment="Center"
                                                MinWidth="96"
                                                AutomationProperties.HelpText="{Binding Title}"
                                                Click="QuickUpdateButton_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="CompactEmptyStatePanel"
                                Visibility="Collapsed" MaxWidth="470"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="24" >
                        <Border Background="#EAF3FF" CornerRadius="22"
                                Width="44" Height="44"
                                HorizontalAlignment="Center">
                            <TextBlock Text="i" Foreground="#1463B8"
                                       FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Nessun risultato da mostrare"
                                   Foreground="#14233F" FontSize="17"
                                   FontWeight="SemiBold" TextAlignment="Center"
                                   Margin="0,14,0,0" />
                        <TextBlock x:Name="CompactEmptyStateText"
                                   Text="Nessun aggiornamento in questa categoria."
                                   Foreground="#526783" FontSize="13"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Margin="0,7,0,0"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Grid>
            </Border>
            <!-- Keep WUA list spacious; OEM guidance is a dedicated opt-in panel.
                 Automatically expanded only for assessed OEM recommendations. -->
            <Expander x:Name="VendorResultsExpander"
                      Grid.Row="3" Header="Produttori e fonti ufficiali"
                      IsExpanded="False" Margin="0,8,0,0"
                      Foreground="#334155"
                      AutomationProperties.Name="Risultati del produttore, fonti ufficiali e strumenti avanzati">
                <Border Background="White" BorderBrush="#E2E8F0"
                        BorderThickness="1" CornerRadius="10" MaxHeight="220">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14,11,14,9">
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="VendorCheckCountText"
                                       Text="Aggiornamenti consigliati dal produttore: 0"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="#0F172A" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock x:Name="VendorCatalogStatusText"
                                   Text="La presenza di una fonte ufficiale non significa che ci sia un aggiornamento."
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="#64748B" Margin="0,3,0,4" />
                        <!-- Eight fixed, privacy-safe comparison categories.
                             Always separate WUA candidates, Software hints and
                             hardware recognition; never a driver install list. -->
                        <Expander x:Name="ReferenceCoverageExpander"
                                  Header="Perché non vedo NVIDIA, Intel e Killer? · 8 componenti"
                                  Visibility="Collapsed" IsExpanded="False"
                                  Margin="0,6,0,6"
                                  Foreground="#334155"
                                  AutomationProperties.Name="Confronta la copertura per otto componenti NVIDIA Intel e Killer">
                            <StackPanel Margin="5,6,5,6">
                                <TextBlock Text="Questa diagnostica confronta hardware riconosciuto, driver offerti da Windows e indizi Software. Non consulta automaticamente i cataloghi NVIDIA o Intel e non aggiunge aggiornamenti."
                                           Foreground="#526783" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,0,0,7" />
                                <ItemsControl x:Name="ReferenceCoverageList"
                                              ItemsSource="{Binding ReferenceCoverageRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E2E8F0"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="7,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Component}"
                                                               Foreground="#14233F"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding PnpStatus}"
                                                               Foreground="#475569"
                                                               FontSize="12" TextWrapping="Wrap"
                                                               Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding WindowsDriverStatus}"
                                                               Foreground="#145DA0"
                                                               FontSize="12" TextWrapping="Wrap"
                                                               Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding SoftwareStatus}"
                                                               Foreground="#64748B"
                                                               FontSize="12" TextWrapping="Wrap"
                                                               Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding NextStep}"
                                                               Foreground="#334155" FontStyle="Italic"
                                                               FontSize="12" TextWrapping="Wrap"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                        <!-- Diagnostic tools are opt-in; confirmed OEM recommendations
                             below remain distinct and readable on first view. -->
                        <Expander x:Name="VendorToolsExpander"
                                  Header="Strumenti e verifiche del produttore"
                                  IsExpanded="False" Margin="0,4,0,0"
                                  Foreground="#334155"
                                  AutomationProperties.Name="Espandi gli strumenti di confronto e le verifiche avanzate OEM">
                            <StackPanel>
                        <WrapPanel Margin="0,3,0,0">
                            <Button x:Name="LenovoApplicableButton"
                                    Content="Controlla con Lenovo"
                                    Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="Cerca driver necessari con Lenovo"
                                    Visibility="Collapsed"
                                    Click="LenovoApplicableButton_Click" />
                            <Button x:Name="DellApplicableButton"
                                    Content="Controlla con Dell"
                                    Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="Cerca driver necessari con Dell"
                                    Visibility="Collapsed"
                                    Click="DellApplicableButton_Click" />
                            <Button x:Name="HpApplicableButton"
                                    Content="Controlla con HP"
                                    Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="Cerca driver consigliati con HP"
                                    Visibility="Collapsed"
                                    Click="HpApplicableButton_Click" />
                            <Button x:Name="PcSpecialistPortalButton"
                                    Content="Driver PCSpecialist"
                                    Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="Apri il portale driver ufficiale PCSpecialist per il tuo ordine"
                                    ToolTip="Apre il sito PCSpecialist. Il numero d'ordine si inserisce soltanto sul portale ufficiale, non in OmegaDrive."
                                    Visibility="Collapsed"
                                    Click="PcSpecialistPortalButton_Click" />
                            <Button x:Name="NvidiaDriverNewsButton"
                                    Content="Novità driver NVIDIA"
                                    Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="Consulta su richiesta annunci ufficiali GeForce Game Ready e Studio, non aggiornamenti installabili"
                                    ToolTip="Interroga soltanto il feed RSS pubblico NVIDIA dopo conferma. Non trasmette identificativi del PC. Gli annunci NON provano aggiornamenti compatibili."
                                    Visibility="Collapsed"
                                    Click="NvidiaDriverNewsButton_Click" />
                            <Button x:Name="CompareLocalOemZipButton"
                                    Content="Confronta ZIP / CAB / EXE multipli"
                                    Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="Confronta fino a dodici pacchetti ZIP CAB o EXE con vero ZIP PE incorporato, senza eseguire alcun installer"
                                    ToolTip="Seleziona da uno a 12 pacchetti ZIP/CAB/EXE OEM. Gli EXE sono SOLO PE con ZIP standard incorporato, letti senza esecuzione; 7z/NSIS/Inno non supportati. CAB: solo Windows expand.exe per INF. Nessun installer o numero ordine trasmesso."
                                    Visibility="Collapsed"
                                    Click="CompareLocalOemZipButton_Click" />
                            <Button x:Name="CompareLocalOemFolderButton"
                                    Content="Confronta cartella driver"
                                    Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="Analizza in sola lettura gli INF contenuti in una cartella driver locale"
                                    ToolTip="Per i driver già estratti da fonte ufficiale. Nessun EXE viene aperto o avviato, solo INF confrontati con i dispositivi Windows."
                                    Visibility="Collapsed"
                                    Click="CompareLocalOemFolderButton_Click" />
                        </WrapPanel>
                        <!-- WUA partial Type=Driver results are ONLY read-only hints.
                             They never bind to CompactUpdatesList, DriverUpdates or Update All. -->
                        <Expander x:Name="PartialWuaHintsExpander"
                                  Header="Driver da ricerche Windows incomplete · NON installabili"
                                  Visibility="Collapsed" IsExpanded="False"
                                  Margin="0,6,0,4"
                                  AutomationProperties.Name="Indizi WUA da fonti parziali, non verificati e mai installabili">
                            <StackPanel Margin="4,6,4,6">
                                <TextBlock x:Name="PartialWuaSourceText"
                                           Text="Nessun indizio da ricerche Windows incomplete."
                                           TextWrapping="Wrap" FontSize="11"
                                           Foreground="#64748B" Margin="0,0,0,5" />
                                <TextBlock Text="Windows Update ha restituito titoli non verificati durante ricerche con errori o avvisi. Non sono offerte confermate, non hanno corrispondenza hardware provata e NON entrano in Aggiorna tutto."
                                           TextWrapping="Wrap" FontSize="11"
                                           Foreground="#64748B" Margin="0,0,0,5" />
                                <ListView x:Name="PartialWuaHintsList"
                                          ItemsSource="{Binding PartialWuaDriverHints}"
                                          MaxHeight="165" BorderThickness="0"
                                          Background="Transparent"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                                          AutomationProperties.Name="Titoli WUA non confermati, solo consultazione">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,4,4,7">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Foreground="#334155" />
                                                <TextBlock Text="{Binding Detail}"
                                                           FontSize="11" TextWrapping="Wrap"
                                                           Foreground="#64748B" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Expander>
                        <!-- Local offline WUA cache is NOT an online offer or an installer. -->
                        <Expander x:Name="CachedWuaHintsExpander"
                                  Header="Archivio Windows locale · storico · NON installabile"
                                  Visibility="Collapsed" IsExpanded="False"
                                  Margin="0,6,0,4"
                                  AutomationProperties.Name="Titoli storici della cache Windows, solo consultazione">
                            <StackPanel Margin="4,6,4,6">
                                <TextBlock x:Name="CachedWuaSourceText"
                                           Text="Archivio Windows locale non ancora verificato."
                                           TextWrapping="Wrap" FontSize="11"
                                           Foreground="#64748B" Margin="0,0,0,5" />
                                <TextBlock Text="La scansione offline legge solo il datastore già presente sul PC. Titoli vecchi o sostituiti NON dimostrano disponibilità online, versione più nuova, compatibilità o installabilità. Non entrano nella lista Aggiorna tutto."
                                           TextWrapping="Wrap" FontSize="11"
                                           Foreground="#64748B" Margin="0,0,0,5" />
                                <ListView x:Name="CachedWuaHintsList"
                                          ItemsSource="{Binding CachedWuaDriverHints}"
                                          MaxHeight="165" BorderThickness="0"
                                          Background="Transparent"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                                          AutomationProperties.Name="Titoli da cache WUA offline, non confermati né installabili">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,4,4,7">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Foreground="#334155" />
                                                <TextBlock Text="{Binding Detail}"
                                                           FontSize="11" TextWrapping="Wrap"
                                                           Foreground="#64748B" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Expander>
                        <!-- WUA Type=Software is not a driver update source. -->
                        <Expander x:Name="RelatedSoftwareExpander"
                                  Header="Componenti software del produttore · da verificare"
                                  Visibility="Collapsed" IsExpanded="False"
                                  Margin="0,6,0,4"
                                  AutomationProperties.Name="Software e componenti del produttore restituiti da Windows Update; non sono aggiornamenti driver confermati">
                            <StackPanel Margin="4,6,4,6">
                                <TextBlock x:Name="RelatedSoftwareSourceText"
                                           Text="Ricerca componenti software non ancora eseguita."
                                           TextWrapping="Wrap" FontSize="11"
                                           Foreground="#64748B" Margin="0,0,0,5" />
                                <TextBlock Text="Questi sono aggiornamenti classificati come Software da Windows Update, selezionati solo dal titolo. Non dimostrano compatibilità col PC né sono installabili da OmegaDrive."
                                           TextWrapping="Wrap" FontSize="11"
                                           Foreground="#64748B" Margin="0,0,0,5" />
                                <ListView x:Name="RelatedSoftwareList"
                                          ItemsSource="{Binding RelatedSoftwareHints}"
                                          MaxHeight="165" BorderThickness="0"
                                          Background="Transparent"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                                          AutomationProperties.Name="Suggerimenti di software OEM separati dagli aggiornamenti driver installabili">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,4,4,7">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Foreground="#334155" />
                                                <TextBlock Text="{Binding Detail}"
                                                           FontSize="11" TextWrapping="Wrap"
                                                           Foreground="#64748B" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Expander>
                        <!-- PnPUtil is a per-device read-only Driver Store view.
                             Its localized stdout is not parsed as WUA/OEM updates. -->
                        <Expander x:Name="WindowsDriverStoreExpander"
                                  Header="Driver locali · rank Windows SetupAPI e PnPUtil"
                                  Visibility="Collapsed"
                                  IsExpanded="False"
                                  Margin="0,8,0,4"
                                  AutomationProperties.Name="Visualizza i driver presenti nel Driver Store di Windows per un dispositivo">
                            <StackPanel Margin="4,6,4,6">
                                <TextBlock Text="Seleziona un dispositivo: OmegaDrive legge il Rank reale dei driver compatibili già presenti in Windows tramite SetupAPI (quando disponibile), oltre alla risposta di PnPUtil. Non cerca aggiornamenti online e NON valuta il ranking degli ZIP/CAB OEM esterni."
                                           Foreground="#64748B" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,0,0,6" />
                                <WrapPanel>
                                    <ComboBox x:Name="WindowsStoreDeviceCombo"
                                              ItemsSource="{Binding Drivers}"
                                              DisplayMemberPath="Name"
                                              Width="320" Height="35"
                                              MaxDropDownHeight="250"
                                              IsTextSearchEnabled="True"
                                              AutomationProperties.Name="Seleziona dispositivo Windows per consultare il ranking dei driver" />
                                    <Button x:Name="WindowsStoreReadButton"
                                            Content="Mostra scelta Windows"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="8,0,0,0"
                                            AutomationProperties.Name="Visualizza i driver in Driver Store per questo dispositivo senza installare"
                                            Click="WindowsStoreReadButton_Click" />
                                </WrapPanel>
                                <!-- Browsing the official Catalog is an explicit, external,
                                     NON-installable handoff. It does not query an API. -->
                                <Button x:Name="HomeCatalogSearchButton"
                                        Content="Cerca pacchetti nel Catalogo Microsoft"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,6,0,0"
                                        ToolTip="Apre solo dopo conferma il catalogo ufficiale con l'ID del modello, senza seriali o Device Instance ID. Non avvia download/installazioni."
                                        AutomationProperties.Name="Cerca manualmente pacchetti driver sul catalogo ufficiale Microsoft, solo dopo conferma"
                                        Click="HomeCatalogSearchButton_Click" />
                                <TextBox x:Name="WindowsStoreEvidenceText"
                                         Visibility="Collapsed"
                                         Text="Driver Store non ancora consultato."
                                         Margin="0,8,0,0" MaxHeight="175"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled"
                                         FontFamily="Consolas" FontSize="11"
                                         AutomationProperties.Name="Rank locali Windows SetupAPI e risposta PnPUtil, identificativi del dispositivo oscurati" />
                                <TextBlock Text="Dati Windows locali: non sono nuovi download né prove di un aggiornamento necessario. Nessun driver viene installato."
                                           Foreground="#64748B" FontSize="11"
                                           Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                        <!-- Local INF device correlations are NOT an OEM recommendation,
                             and must never be bound to the installable WUA list. -->
                        <Expander x:Name="LocalOemComparisonExpander"
                                  Header="Confronto pacchetto OEM locale · non installabile"
                                  Visibility="Collapsed"
                                  IsExpanded="True" Margin="0,6,0,4"
                                  AutomationProperties.Name="Confronto dei driver di un archivio OEM locale e dei dispositivi Windows">
                            <StackPanel Margin="4,6,4,4">
                                <TextBlock x:Name="LocalOemComparisonSummaryText"
                                           Text="Nessun archivio confrontato."
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#334155" TextWrapping="Wrap" />
                                <TextBlock Text="Sono corrispondenze INF preliminari, NON aggiornamenti verificati. Firma, dipendenze e installazione richiedono controlli separati."
                                           FontSize="11" Foreground="#64748B"
                                           Margin="0,4,0,4" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,6,0,2">
                                    <Button x:Name="VerifyOemFolderCatalogButton"
                                            Content="Verifica firme e file driver"
                                            Style="{StaticResource SecondaryButton}"
                                            Visibility="Collapsed"
                                            AutomationProperties.Name="Verifica firme CAT e appartenenza INF su cartella OEM locale già confrontata"
                                            ToolTip="Controllo read-only su firma CAT, INF e alcuni file SYS/DLL richiamati. Non certifica tutte le dipendenze e non installa driver."
                                            Click="VerifyOemFolderCatalogButton_Click" />
                                </WrapPanel>
                                <TextBlock x:Name="LocalOemCatalogAuditText"
                                           Text="Firme INF/CAT non verificate."
                                           Visibility="Collapsed"
                                           FontSize="11" Foreground="#475569"
                                           TextWrapping="Wrap" Margin="0,2,0,5" />
                                <ListView x:Name="LocalOemFindingsList"
                                          ItemsSource="{Binding LocalOemFindings}"
                                          MaxHeight="160"
                                          BorderThickness="0" Background="Transparent"
                                          HorizontalContentAlignment="Stretch"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="3,5,3,5">
                                                <TextBlock Text="{Binding Summary}"
                                                           FontSize="12" Foreground="#334155"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding InfName, StringFormat='INF: {0}'}"
                                                           FontSize="11" Foreground="#64748B"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Expander>
                            </StackPanel>
                        </Expander>
                        <!-- Only manufacturer-assessed necessary packages appear
                             here. They NEVER enter the WUA Update All list. -->
                        <ListView x:Name="VendorChecksList"
                                  ItemsSource="{Binding VendorApplicableView}"
                                  Visibility="Collapsed" MaxHeight="148"
                                  BorderThickness="0" Background="Transparent"
                                  HorizontalContentAlignment="Stretch"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  AutomationProperties.Name="Driver consigliati da strumenti ufficiali OEM">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E2E8F0"
                                            BorderThickness="0,0,0,1" Padding="8,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#0F172A" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}"
                                                           FontSize="11" Foreground="#64748B"
                                                           Margin="0,3,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="Segnalato dal produttore · installazione manuale"
                                                           FontSize="11" Foreground="#64748B"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Sito ufficiale"
                                                    Style="{StaticResource SecondaryButton}"
                                                    VerticalAlignment="Center" MinWidth="110"
                                                    Margin="12,0,0,0"
                                                    Click="VendorSourceButton_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Expander x:Name="OtherVendorSourcesExpander"
                                  Header="Altri dispositivi riconosciuti (non sono aggiornamenti)"
                                  Margin="0,5,0,0" Foreground="#475569"
                                  IsExpanded="False">
                            <ListView x:Name="VendorHandoffsList"
                                      ItemsSource="{Binding VendorHandoffsView}"
                                      MaxHeight="165" Margin="0,7,0,2"
                                      BorderThickness="0" Background="Transparent"
                                      HorizontalContentAlignment="Stretch"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      AutomationProperties.Name="Dispositivi e fonti ufficiali da consultare">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E2E8F0"
                                                BorderThickness="0,0,0,1"
                                                Padding="8,7">
                                            <DockPanel LastChildFill="True">
                                                <Button DockPanel.Dock="Right"
                                                        Content="Sito del produttore"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Margin="12,0,0,0"
                                                        Click="VendorSourceButton_Click" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="12"
                                                               Foreground="#334155"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding StatusText}"
                                                               FontSize="11"
                                                               Foreground="#64748B"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
                </Border>
            </Expander>

            <Border Grid.Row="4" Background="#F9FBFF"
                    BorderBrush="#D6E4F5" BorderThickness="1"
                    CornerRadius="14" Padding="14,11" Margin="0,9,0,0">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <Button x:Name="CompactUpdateAllButton"
                                DockPanel.Dock="Right"
                                Content="Aggiorna tutto"
                                ToolTip="Aggiorna tutti i candidati Windows Update ordinari, anche quelli nascosti dal filtro o dalla ricerca"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="180" Padding="20,13"
                                Margin="8,0,0,0"
                                AutomationProperties.Name="Aggiorna tutti i candidati ordinari Windows Update"
                                Click="CompactUpdateAllButton_Click" />
                        <Button x:Name="CompactUpdateSelectedButton"
                                DockPanel.Dock="Right"
                                Content="Aggiorna selezionati"
                                ToolTip="Aggiorna solo i driver selezionati visibili nell'elenco corrente"
                                AutomationProperties.Name="Aggiorna i driver selezionati visibili nel filtro corrente"
                                Style="{StaticResource SecondaryButton}"
                                Padding="14,12" Margin="8,0,0,0"
                                Click="CompactUpdateSelectedButton_Click" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="CompactSelectionSummaryText"
                                       Text="Solo driver Windows Update ordinari. Nessun OEM installato automaticamente."
                                       Foreground="#334155" FontSize="12"
                                       TextWrapping="Wrap" />

                        </StackPanel>
                    </DockPanel>
                    <Expander Header="Dettagli tecnici e stato delle fonti"
                              Margin="0,8,0,0" Foreground="#334155">
                        <StackPanel Margin="4,10,4,2">
                            <TextBlock x:Name="HomeCoverageText"
                                       Foreground="#475569" TextWrapping="Wrap" />
                            <TextBlock x:Name="HomeInstalledDriverEvidenceText"
                                       Margin="0,10,0,0" Foreground="#475569"
                                       TextWrapping="Wrap" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="CopyCoverageReportButton"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="Copia report della ricerca"
                                        AutomationProperties.Name="Copia report aggregato senza dati identificativi"
                                        Click="CopyCoverageReportButton_Click" />
                                <Button x:Name="HomeUpdatesButton"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Elenco tecnico"
                                        Click="HomeUpdatesButton_Click" />
                                <Button x:Name="HomeProblemsButton"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Problemi dispositivi"
                                        Click="HomeProblemsButton_Click" />
                                <Button x:Name="HomeOemButton"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Fonti OEM"
                                        Click="HomeOemButton_Click" />
                            </WrapPanel>
                            <TextBlock Text="Una fonte OEM rilevata non equivale a un driver verificato. Per pacchetti vendor usa i canali ufficiali indicati nei dettagli."
                                       Foreground="#64748B" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
        </Grid>

        <TabControl x:Name="MainTabs"
                    Grid.Row="3"
                    Visibility="Collapsed"
                    Background="White">
            <TabItem x:Name="DriversTab" Header="Driver installati">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,0,10">
                        <DockPanel>
                            <TextBlock x:Name="FilteredDevicesCountText"
                                       DockPanel.Dock="Right"
                                       VerticalAlignment="Center"
                                       Foreground="#64748B"
                                       Margin="12,0,0,0"
                                       Text="Visualizzati 0 di 0" />

                            <WrapPanel>
                                <TextBox x:Name="DeviceSearchTextBox"
                                         Width="260"
                                         Margin="0,0,10,0"
                                         Padding="8,6"
                                         ToolTip="Cerca per dispositivo, produttore, provider, ID o fonte"
                                         TextChanged="DeviceSearchTextBox_TextChanged" />

                                <ComboBox x:Name="StatusFilterComboBox"
                                          Width="190"
                                          Margin="0,0,10,0"
                                          SelectedValuePath="Tag"
                                          SelectionChanged="DriverFilter_Changed">
                                    <ComboBoxItem Content="Tutti gli stati"
                                                  Tag="all" />
                                    <ComboBoxItem Content="Da controllare"
                                                  Tag="attention" />
                                    <ComboBoxItem Content="Problemi hardware"
                                                  Tag="hardware-problems" />
                                    <ComboBoxItem Content="Aggiornamento disponibile"
                                                  Tag="Aggiornamento disponibile" />
                                    <ComboBoxItem Content="Driver mancante"
                                                  Tag="Driver mancante" />
                                    <ComboBoxItem Content="Da verificare"
                                                  Tag="Da verificare" />
                                    <ComboBoxItem Content="Errore Windows"
                                                  Tag="Errore Windows" />
                                    <ComboBoxItem Content="OK"
                                                  Tag="OK" />
                                </ComboBox>

                                <ComboBox x:Name="SourceFilterComboBox"
                                          Width="180"
                                          SelectedValuePath="Tag"
                                          SelectionChanged="DriverFilter_Changed">
                                    <ComboBoxItem Content="Tutte le fonti"
                                                  Tag="all" />
                                    <ComboBoxItem Content="Windows Update"
                                                  Tag="Windows Update" />
                                    <ComboBoxItem Content="Intel"
                                                  Tag="Intel" />
                                    <ComboBoxItem Content="NVIDIA"
                                                  Tag="NVIDIA" />
                                    <ComboBoxItem Content="AMD"
                                                  Tag="AMD" />
                                    <ComboBoxItem Content="OEM del PC"
                                                  Tag="OEM" />
                                    <ComboBoxItem Content="Windows / OEM"
                                                  Tag="Windows / OEM" />
                                </ComboBox>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <DataGrid x:Name="DriversGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding DriversView}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              SelectionChanged="DriversGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Stato"
                                                    Width="175">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBackground}"
                                                CornerRadius="10"
                                                Padding="8,3"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="{Binding StatusForeground}"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Dispositivo"
                                                Binding="{Binding Name}"
                                                Width="2*" />
                            <DataGridTextColumn Header="Fonte consigliata"
                                                Binding="{Binding RecommendedSource}"
                                                Width="*" />
                            <DataGridTextColumn Header="Produttore"
                                                Binding="{Binding Manufacturer}"
                                                Width="*" />
                            <DataGridTextColumn Header="Driver installato"
                                                Binding="{Binding DriverVersion}"
                                                Width="*" />
                            <DataGridTextColumn Header="Update proposto"
                                                Binding="{Binding AvailableUpdateTitle}"
                                                Width="2*" />
                            <DataGridTextColumn Header="Data update"
                                                Binding="{Binding AvailableUpdateDate}"
                                                Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedItem.Name, ElementName=DriversGrid, TargetNullValue=Seleziona un dispositivo per visualizzare i dettagli.}"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A" />
                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Margin="0,0,18,0">
                                    <Run Text="Stato: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedItem.Status, ElementName=DriversGrid, TargetNullValue=—}" />
                                </TextBlock>
                                <TextBlock Margin="0,0,18,0">
                                    <Run Text="Fonte consigliata: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedItem.RecommendedSource, ElementName=DriversGrid, TargetNullValue=—}" />
                                </TextBlock>
                                <TextBlock Margin="0,0,18,0">
                                    <Run Text="Provider installato: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedItem.DriverProvider, ElementName=DriversGrid, TargetNullValue=—}" />
                                </TextBlock>
                                <TextBlock Margin="0,0,18,0">
                                    <Run Text="Versione: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedItem.DriverVersion, ElementName=DriversGrid, TargetNullValue=—}" />
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Codice Windows: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedItem.ConfigManagerErrorCode, ElementName=DriversGrid, TargetNullValue=—}" />
                                </TextBlock>
                            </WrapPanel>
                            <TextBlock Margin="0,5,0,0"
                                       TextWrapping="Wrap">
                                <Run Text="Dettaglio: " FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedItem.StatusDetail, ElementName=DriversGrid, TargetNullValue=—}" />
                            </TextBlock>
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                                <Run Text="Hardware ID: " FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedItem.HardwareIdsText, ElementName=DriversGrid, TargetNullValue=—}" />
                            </TextBlock>
                            <TextBlock Margin="0,3,0,0" TextWrapping="Wrap">
                                <Run Text="Compatible ID: " FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedItem.CompatibleIdsText, ElementName=DriversGrid, TargetNullValue=—}" />
                            </TextBlock>
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="#475569"
                                       TextWrapping="Wrap">
                                <Run Text="Identificazione hardware: " FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedItem.HardwareIdentityHint, ElementName=DriversGrid, TargetNullValue=—}" />
                            </TextBlock>
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="#0F6CBD"
                                       TextWrapping="Wrap">
                                <Run Text="Discovery+: " FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedItem.DiscoveryGuidance, ElementName=DriversGrid, TargetNullValue=—}" />
                            </TextBlock>
                            <!-- The device can have advanced/hidden WUA matches
                                 even when no ordinary WUA update is installable. -->
                            <Border x:Name="ReviewOnlyWuaDevicePanel"
                                    Background="#FFF8EB" BorderBrush="#E8CE92"
                                    BorderThickness="1" CornerRadius="7"
                                    Padding="10,7" Margin="0,7,0,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem.HasReviewOnlyWuaCandidate, ElementName=DriversGrid}"
                                                         Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="#8A4B08" TextWrapping="Wrap">
                                        <Run Text="WUA · solo verifica per ID o modello: " />
                                        <Run Text="{Binding SelectedItem.ReviewOnlyCandidateTitle, ElementName=DriversGrid}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding SelectedItem.ReviewOnlyCandidateSummary, ElementName=DriversGrid}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="#6B4C16" />
                                    <Button x:Name="DeviceReviewAdvancedButton"
                                            Content="Apri elenco da verificare"
                                            Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Left"
                                            Margin="0,7,0,0"
                                            AutomationProperties.Name="Visualizza i candidati Windows Update da verificare, inclusi indizi per solo modello; nessuna installazione automatica"
                                            Click="ShowAdvancedUpdatesButton_Click" />
                                </StackPanel>
                            </Border>
                            <TextBlock Margin="0,6,0,0"
                                       TextWrapping="Wrap">
                                <Run Text="Update ordinario Windows Update: " FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedItem.AvailableUpdateTitle, ElementName=DriversGrid, TargetNullValue=—}" />
                            </TextBlock>
                            <WrapPanel Margin="0,3,0,0">
                                <TextBlock Margin="0,0,18,0">
                                    <Run Text="Provider update: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedItem.AvailableUpdateProvider, ElementName=DriversGrid, TargetNullValue=—}" />
                                </TextBlock>
                                <TextBlock Margin="0,0,18,0">
                                    <Run Text="Modello: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedItem.AvailableUpdateModel, ElementName=DriversGrid, TargetNullValue=—}" />
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Data update: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedItem.AvailableUpdateDate, ElementName=DriversGrid, TargetNullValue=—}" />
                                </TextBlock>
                            </WrapPanel>
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="#64748B"
                                       TextTrimming="CharacterEllipsis">
                                <Run Text="Hardware ID associato: " FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedItem.MatchedHardwareId, ElementName=DriversGrid, TargetNullValue=—}" />
                            </TextBlock>
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="#64748B"
                                       TextWrapping="Wrap">
                                <Run Text="Qualità corrispondenza: " FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedItem.MatchEvidence, ElementName=DriversGrid, TargetNullValue=—}" />
                            </TextBlock>
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="#475569"
                                       TextWrapping="Wrap">
                                <Run Text="Valutazione Discovery+: " FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedItem.CandidateAssessment, ElementName=DriversGrid, TargetNullValue=—}" />
                            </TextBlock>
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="#64748B"
                                       TextTrimming="CharacterEllipsis">
                                <Run Text="Device ID: " FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedItem.DeviceId, ElementName=DriversGrid, TargetNullValue=—}" />
                            </TextBlock>
                            <TextBlock Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="#1E40AF">
                                <Run Text="Prossimo passo: " FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedItem.NextAction, ElementName=DriversGrid, TargetNullValue=Seleziona un dispositivo.}" />
                            </TextBlock>
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="DeepSearchForDeviceButton"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Ricerca approfondita del PC"
                                        Click="DeepSearchForDeviceButton_Click" />
                                <Button x:Name="CopySelectedHardwareIdButton"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Copia Hardware ID"
                                        Click="CopySelectedHardwareIdButton_Click" />
                                <Button x:Name="DeviceCatalogSearchButton"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Cerca nel Catalogo Microsoft"
                                        ToolTip="Sola ricerca manuale: non aggiunge driver installabili e apre il browser soltanto dopo conferma."
                                        AutomationProperties.Name="Ricerca manuale per modello di questo dispositivo nel Microsoft Update Catalog"
                                        Click="DeviceCatalogSearchButton_Click" />
                                <Button x:Name="GoToOemSourcesButton"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Apri fonti ufficiali OEM"
                                        Click="GoToOemSourcesButton_Click" />
                            </WrapPanel>
                            <Button x:Name="InstallDeviceUpdateButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="Installa update di questo dispositivo"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0"
                                    IsEnabled="False"
                                    Click="InstallDeviceUpdateButton_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="UpdatesTab"
                     Header="Aggiornamenti disponibili">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,0,10">
                        <DockPanel>
                            <TextBlock x:Name="FilteredUpdatesCountText"
                                       DockPanel.Dock="Right"
                                       VerticalAlignment="Center"
                                       Foreground="#64748B"
                                       Margin="12,0,0,0"
                                       Text="Visualizzati 0 di 0" />

                            <WrapPanel>
                                <TextBox x:Name="UpdateSearchTextBox"
                                         Width="290"
                                         Margin="0,0,10,0"
                                         Padding="8,6"
                                         ToolTip="Cerca aggiornamento, provider, modello, classe o hardware ID"
                                         TextChanged="UpdateSearchTextBox_TextChanged" />

                                <ComboBox x:Name="UpdateSelectionFilterComboBox"
                                          Width="180"
                                          Margin="0,0,10,0"
                                          SelectedValuePath="Tag"
                                          SelectionChanged="UpdateFilter_Changed">
                                    <ComboBoxItem Content="Tutti gli update"
                                                  Tag="all" />
                                    <ComboBoxItem Content="Solo selezionati"
                                                  Tag="selected" />
                                    <ComboBoxItem Content="Solo non selezionati"
                                                  Tag="unselected" />
                                </ComboBox>

                                <ComboBox x:Name="UpdateKindFilterComboBox"
                                          Width="170"
                                          SelectedValuePath="Tag"
                                          SelectionChanged="UpdateFilter_Changed">
                                    <ComboBoxItem Content="Tutti i tipi"
                                                  Tag="all" />
                                    <ComboBoxItem Content="Consigliati"
                                                  Tag="Consigliato" />
                                    <ComboBoxItem Content="Facoltativi"
                                                  Tag="Facoltativo" />
                                    <ComboBoxItem Content="Avanzati + nascosti"
                                                  Tag="advanced-all" />
                                    <ComboBoxItem Content="Solo avanzati"
                                                  Tag="Avanzato" />
                                    <ComboBoxItem Content="Solo nascosti"
                                                  Tag="Nascosto" />
                                </ComboBox>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1"
                          Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0"
                                Click="ShowRecommendedUpdatesButton_Click">
                            <StackPanel>
                                <TextBlock Text="Consigliati per il PC"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A" />
                                <TextBlock x:Name="RecommendedUpdatesCountText"
                                           Text="0"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="#0F6CBD"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0"
                                Click="ShowOptionalUpdatesButton_Click">
                            <StackPanel>
                                <TextBlock Text="Facoltativi"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A" />
                                <TextBlock x:Name="OptionalUpdatesCountText"
                                           Text="0"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="#475569"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0"
                                Click="ShowOemSourcesButton_Click">
                            <StackPanel>
                                <TextBlock Text="Fonti OEM"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A" />
                                <TextBlock x:Name="OemSourcesCountText"
                                           Text="0"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="#475569"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="3"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0"
                                Click="ShowAdvancedUpdatesButton_Click">
                            <StackPanel>
                                <TextBlock Text="Avanzati"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A" />
                                <TextBlock x:Name="AdvancedUpdatesCountText"
                                           Text="0"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="#B45309"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <DataGrid x:Name="UpdatesGrid"
                              Grid.Row="2"
                              ItemsSource="{Binding DriverUpdatesView}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Installa"
                                                    Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="Auto" />
                            <DataGridTextColumn Header="Tipo"
                                                Binding="{Binding KindText}"
                                                IsReadOnly="True"
                                                Width="110" />
                            <DataGridTextColumn Header="Aggiornamento"
                                                Binding="{Binding Title}"
                                                IsReadOnly="True"
                                                Width="3*" />
                            <DataGridTextColumn Header="Fonte ricerca"
                                                Binding="{Binding SearchSource}"
                                                IsReadOnly="True"
                                                Width="175" />
                            <DataGridTextColumn Header="Provider"
                                                Binding="{Binding Provider}"
                                                IsReadOnly="True"
                                                Width="*" />
                            <DataGridTextColumn Header="Modello"
                                                Binding="{Binding Model}"
                                                IsReadOnly="True"
                                                Width="*" />
                            <DataGridTextColumn Header="Classe"
                                                Binding="{Binding DriverClass}"
                                                IsReadOnly="True"
                                                Width="*" />
                            <DataGridTextColumn Header="Data driver"
                                                Binding="{Binding DriverDateText}"
                                                IsReadOnly="True"
                                                Width="Auto" />
                            <DataGridTextColumn Header="Dimensione"
                                                Binding="{Binding SizeText}"
                                                IsReadOnly="True"
                                                Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3"
                                Margin="0,10,0,0">
                        <TextBlock Foreground="#64748B"
                                   Margin="0,0,0,8"
                                   TextWrapping="Wrap"
                                   Text="Fonti OEM = canali ufficiali applicabili al PC, non numero di driver già rilevati. I risultati avanzati/nascosti non sono preselezionati." />
                        <WrapPanel>
                        <Button x:Name="SelectAllUpdatesButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="Seleziona tutti"
                                Click="SelectAllUpdatesButton_Click" />
                        <Button x:Name="DeselectAllUpdatesButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="Deseleziona tutti"
                                Click="DeselectAllUpdatesButton_Click" />
                        <Button x:Name="InstallSelectedButton"
                                Style="{StaticResource PrimaryButton}"
                                Content="Scarica e installa selezionati"
                                Click="InstallSelectedButton_Click" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="#64748B"
                                   Text="L'installazione parte solo dopo una tua azione esplicita." />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="OemProvidersTab"
                     Header="Provider OEM">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,10">
                        <TextBlock Text="Provider OEM ufficiali"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   Text="Windows Update resta la fonte automatica integrata. OmegaDrive rileva Intel, NVIDIA, AMD e il produttore del PC (Dell, Lenovo, HP, ASUS, Acer, MSI, GIGABYTE, Surface), usando solo flussi ufficiali." />
                    </StackPanel>

                    <DataGrid x:Name="OemProvidersGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding OemProviders}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Provider"
                                                Binding="{Binding DisplayName}"
                                                Width="*" />
                            <DataGridTextColumn Header="Dispositivi rilevati"
                                                Binding="{Binding DetectedDeviceCount}"
                                                Width="Auto" />
                            <DataGridTextColumn Header="Modello PC"
                                                Binding="{Binding SystemIdentity}"
                                                Width="*" />
                            <DataGridTextColumn Header="Integrazione"
                                                Binding="{Binding IntegrationMode}"
                                                Width="*" />
                            <DataGridTextColumn Header="Companion"
                                                Binding="{Binding CompanionStatus}"
                                                Width="*" />
                            <DataGridTextColumn Header="Stato"
                                                Binding="{Binding Message}"
                                                Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <Expander Header="HP — catalogo SoftPaq ufficiale (CMSL installata)"
                                  Margin="0,0,0,8">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Foreground="#475569"
                                           TextWrapping="Wrap"
                                           Text="Richiede HP CMSL già installata. Interroga il catalogo Driver del PC HP e la versione Windows locale; non installa driver, BIOS o firmware." />
                                <Button x:Name="ReadHpSoftpaqCatalogButton"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Consulta SoftPaq HP"
                                        Click="ReadHpSoftpaqCatalogButton_Click"
                                        HorizontalAlignment="Left"
                                        Margin="0,6,0,0" />
                                <TextBox x:Name="HpCatalogResultsTextBox"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Height="85"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="Nessuna consultazione eseguita." />
                            </StackPanel>
                        </Expander>
                        <Expander Header="Lenovo — catalogo ufficiale (modulo già installato)"
                                  Margin="0,0,0,8">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="#475569"
                                           Text="Inserisci il MachineType Lenovo di 4 caratteri (non il seriale). Usa Lenovo.Client.Scripting ufficiale; nessun driver viene installato." />
                                <WrapPanel Margin="0,6,0,0">
                                    <TextBox x:Name="LenovoMachineTypeTextBox"
                                             Width="115"
                                             MaxLength="4"
                                             Margin="0,0,8,0"
                                             ToolTip="MachineType Lenovo, ad esempio 21HD." />
                                    <Button x:Name="ReadLenovoDriverCatalogButton"
                                            Style="{StaticResource SecondaryButton}"
                                            Content="Consulta Lenovo"
                                            Click="ReadLenovoDriverCatalogButton_Click" />
                                </WrapPanel>
                                <TextBox x:Name="LenovoCatalogResultsTextBox"
                                         Text="Nessuna consultazione eseguita."
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Height="85"
                                         VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Expander>
                        <TextBlock Margin="0,0,0,8"
                                   TextWrapping="Wrap"
                                   Foreground="#475569"
                                   Text="{Binding SelectedItem.SupportInstructions, ElementName=OemProvidersGrid, TargetNullValue=Seleziona un provider per le istruzioni di ricerca ufficiale.}" />
                        <WrapPanel>
                        <Button x:Name="RefreshOemProvidersButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="Aggiorna provider OEM"
                                Click="RefreshOemProvidersButton_Click" />
                        <Button x:Name="OpenSelectedOemProviderButton"
                                Style="{StaticResource PrimaryButton}"
                                Content="Apri supporto ufficiale"
                                Click="OpenSelectedOemProviderButton_Click" />
                        <Button x:Name="OpenSurfaceDownloadCenterButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="Pacchetti Surface Microsoft"
                                ToolTip="Apre il catalogo Microsoft del modello identificato. I pacchetti MSI possono includere firmware."
                                Click="OpenSurfaceDownloadCenterButton_Click" />
                        <Button x:Name="ReadDellDriverCatalogButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="Consulta catalogo Dell"
                                ToolTip="Legge soltanto metadati Dell Command Deploy. Seleziona prima il provider del PC Dell."
                                Click="ReadDellDriverCatalogButton_Click" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="#64748B"
                                   Text="Cataloghi OEM: metadati informativi, non installazioni." />
                        </WrapPanel>
                        <ScrollViewer MaxHeight="140"
                                      Margin="0,7,0,0"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="DellCatalogResultsText"
                                       Foreground="#475569"
                                       TextWrapping="Wrap"
                                       Text="Dell: seleziona il provider di un PC Dell e consulta i Driver Pack di deployment ufficiali. Per driver individuali usa il portale del produttore." />
                        </ScrollViewer>
                        <Expander Header="Fonti e interfacce OEM documentate (15 produttori)"
                                  Margin="0,8,0,0"
                                  ToolTip="Cataloghi, utility locali e supporto ufficiale sono capacità distinte.">
                            <DataGrid ItemsSource="{Binding OemCatalogSources}"
                                      Height="180"
                                      Margin="0,6,0,0"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Produttore"
                                                        Binding="{Binding Vendor}" Width="*" />
                                    <DataGridTextColumn Header="Tipo integrazione"
                                                        Binding="{Binding Access}" Width="*" />
                                    <DataGridTextColumn Header="Limitazioni"
                                                        Binding="{Binding Limitations}" Width="3*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Discovery+">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock FontSize="18" FontWeight="SemiBold"
                                   Text="Risultati Discovery+ per sorgente" />
                        <WrapPanel Margin="0,8,0,2">
                            <Button x:Name="InspectInfButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Analizza INF e integrità"
                                    ToolTip="Calcola SHA-256 e consulta la firma CAT di Windows; nessuna installazione."
                                    Click="InspectInfButton_Click" />
                            <TextBlock Margin="10,0,5,0"
                                       VerticalAlignment="Center"
                                       Foreground="#475569"
                                       Text="SHA-256 INF atteso (facoltativo):" />
                            <TextBox x:Name="ExpectedInfSha256TextBox"
                                     Width="270"
                                     MaxLength="64"
                                     ToolTip="Copia il digest SHA-256 pubblicato dal produttore da una fonte attendibile. Senza digest esterno l'impronta è solo informativa." />
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#64748B"
                                       Text="Nessuna installazione da Discovery+." />
                        </WrapPanel>
                        <Button x:Name="InspectOemArchiveButton"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left"
                                Margin="0,6,0,4"
                                Content="Ispeziona archivio OEM locale"
                                ToolTip="Solo indice ZIP, CAB/MSI/EXE non estratti. Nessun download o installazione."
                                Click="InspectOemArchiveButton_Click" />
                        <ScrollViewer MaxHeight="155" Margin="0,3,0,7"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="OemArchiveResultsText"
                                       Foreground="#475569" TextWrapping="Wrap"
                                       Text="Archivio OEM non analizzato. Analisi statica e non verificata." />
                        </ScrollViewer>
                        <Button x:Name="AuditPackageFilesButton"
                                Style="{StaticResource SecondaryButton}"
                                IsEnabled="False"
                                HorizontalAlignment="Left"
                                Margin="0,6,0,4"
                                Content="Verifica file SYS/DLL/INF nella cartella"
                                ToolTip="Richiede INF e CAT locali e Windows SDK SignTool. Verifica parziale in sola lettura."
                                Click="AuditPackageFilesButton_Click" />
                        <ScrollViewer MaxHeight="175"
                                      Margin="0,3,0,7"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="PayloadAuditResultsText"
                                       Foreground="#475569"
                                       TextWrapping="Wrap"
                                       Text="Audit file non ancora eseguito. Nessuna installazione OEM." />
                        </ScrollViewer>
                        <ScrollViewer MaxHeight="190"
                                      Margin="0,3,0,5"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="InfEvidenceText"
                                       Foreground="#475569"
                                       TextWrapping="Wrap"
                                       Text="INF: non analizzato. Seleziona prima un dispositivo per confrontarlo." />
                        </ScrollViewer>
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="#64748B"
                                   Margin="0,0,0,5"
                                   Text="Membership INF nel CAT: richiede Microsoft Windows SDK SignTool già installato. Non verifica l'intero pacchetto." />
                        <CheckBox x:Name="DiscoveryDeviceOnlyCheckBox"
                                  Margin="0,8,0,4"
                                  Content="Solo candidati Windows Update del dispositivo selezionato"
                                  ToolTip="Seleziona prima un dispositivo in Driver installati. I pacchetti OEM non hanno ancora evidenza per-device."
                                  Checked="DiscoveryDeviceFilter_Changed"
                                  Unchecked="DiscoveryDeviceFilter_Changed" />
                        <TextBlock Margin="0,4,0,0" Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   Text="Questa vista mostra i risultati WUA dell'ultima ricerca e i metadati OEM consultati in questa sessione. I pacchetti OEM non sono installabili da qui. Lenovo, HP e Dell sono metadati informativi OEM, non driver automaticamente installabili." />
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <TextBlock x:Name="DiscoveryAssessmentText"
                                   Margin="0,0,0,7"
                                   Foreground="#334155"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Text="Seleziona un risultato per vedere la valutazione." />
                        <DataGrid x:Name="DiscoveryResultsGrid"
                                  Height="370"
                                  SelectionChanged="DiscoveryResultsGrid_SelectionChanged"
                                  ItemsSource="{Binding DiscoveryResultsView}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Stato" Binding="{Binding VerificationLabel}" Width="175" />
                            <DataGridTextColumn Header="Tipo" Binding="{Binding KindLabel}" Width="180" />
                            <DataGridTextColumn Header="Fonte" Binding="{Binding Source}" Width="140" />
                            <DataGridTextColumn Header="Pacchetto / Driver" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="Versione" Binding="{Binding Version}" Width="90" />
                            <DataGridTextColumn Header="Evidenza" Binding="{Binding Evidence}" Width="2*" />
                            <DataGridTextColumn Header="Limiti / Prossima azione" Binding="{Binding Guidance}" Width="2*" />
                        </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Cronologia">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="Esporta CSV"
                                    Click="ExportInstallHistoryButton_Click" />
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="Aggiorna cronologia"
                                    Click="RefreshInstallHistoryButton_Click" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Cronologia installazioni richieste"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Esito complessivo riferito dal servizio. Non certifica il successo di ciascun driver. Ultimi 200 eventi sul PC locale."
                                       Foreground="#64748B"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBox x:Name="HistorySearchTextBox"
                                 Width="290"
                                 Padding="8,6"
                                 Margin="0,0,10,0"
                                 ToolTip="Cerca nome driver, esito o messaggio"
                                 TextChanged="HistorySearchTextBox_TextChanged" />
                        <ComboBox x:Name="HistoryOutcomeFilterComboBox"
                                  Width="210"
                                  SelectedValuePath="Tag"
                                  SelectionChanged="HistoryFilter_Changed"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Tutti gli eventi" Tag="all" />
                            <ComboBoxItem Content="Batch riusciti" Tag="succeeded" />
                            <ComboBoxItem Content="Batch non riusciti" Tag="failed" />
                            <ComboBoxItem Content="Operazioni interrotte" Tag="interrupted" />
                            <ComboBoxItem Content="Riavvio richiesto" Tag="reboot" />
                        </ComboBox>
                    </WrapPanel>
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding InstallHistoryView}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data/ora UTC"
                                                Binding="{Binding TimestampUtc, StringFormat=yyyy-MM-dd HH:mm}"
                                                Width="155" />
                            <DataGridTextColumn Header="Driver richiesti"
                                                Binding="{Binding DriverTitles}"
                                                Width="3*" />
                            <DataGridTextColumn Header="Esito batch"
                                                Binding="{Binding Outcome}"
                                                Width="*" />
                            <DataGridCheckBoxColumn Header="Riavvio"
                                                    Binding="{Binding RebootRequired}"
                                                    Width="75" />
                            <DataGridTextColumn Header="Messaggio del servizio"
                                                Binding="{Binding Message}"
                                                Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Diagnostica">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0"
                               Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal">
                            <Button x:Name="RefreshDiagnosticsButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Aggiorna diagnostica"
                                    Click="RefreshDiagnosticsButton_Click" />
                            <Button x:Name="CopyDiagnosticsButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Copia log"
                                    Click="CopyDiagnosticsButton_Click" />
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Servizio privilegiato"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Ultime informazioni e fino a 200 righe del log corrente."
                                       Foreground="#64748B"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <WrapPanel Grid.Row="1"
                               Margin="0,0,0,10">
                        <TextBlock Margin="0,0,20,0">
                            <Run Text="Versione: " FontWeight="SemiBold" />
                            <Run x:Name="ServiceVersionText" Text="—" />
                        </TextBlock>
                        <TextBlock Margin="0,0,20,0">
                            <Run Text="Avviato: " FontWeight="SemiBold" />
                            <Run x:Name="ServiceStartedText" Text="—" />
                        </TextBlock>
                        <TextBlock>
                            <Run Text="Log: " FontWeight="SemiBold" />
                            <Run x:Name="ServiceLogPathText" Text="—" />
                        </TextBlock>
                    </WrapPanel>

                    <TextBox x:Name="DiagnosticsLogTextBox"
                             Grid.Row="2"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             FontSize="12"
                             Background="#0F172A"
                             Foreground="#E2E8F0"
                             BorderThickness="0"
                             Padding="12"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Text="Nessun dato diagnostico caricato." />
                </Grid>
            </TabItem>

            <TabItem Header="Impostazioni">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,14">
                        <TextBlock Text="Comportamento applicazione"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A" />
                        <TextBlock Text="Le preferenze vengono applicate subito e salvate per il tuo profilo Windows."
                                   Foreground="#64748B"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox x:Name="StartWithWindowsCheckBox"
                                      Content="Avvia OmegaDrive con Windows"
                                      FontWeight="SemiBold"
                                      Margin="0,0,0,12"
                                      Checked="SettingsCheckBox_Changed"
                                      Unchecked="SettingsCheckBox_Changed" />
                            <TextBlock Text="Modifica la voce di avvio automatico del tuo profilo Windows."
                                       Foreground="#64748B"
                                       Margin="24,-8,0,14" />

                            <CheckBox x:Name="MinimizeToTrayCheckBox"
                                      Content="Minimizza nell'area di notifica"
                                      FontWeight="SemiBold"
                                      Margin="0,0,0,12"
                                      Checked="SettingsCheckBox_Changed"
                                      Unchecked="SettingsCheckBox_Changed" />
                            <TextBlock Text="Quando minimizzi la finestra, l'app resta attiva nel tray."
                                       Foreground="#64748B"
                                       Margin="24,-8,0,14" />

                            <CheckBox x:Name="CloseToTrayCheckBox"
                                      Content="Chiudi nel tray invece di terminare l'app"
                                      FontWeight="SemiBold"
                                      Margin="0,0,0,12"
                                      Checked="SettingsCheckBox_Changed"
                                      Unchecked="SettingsCheckBox_Changed" />
                            <TextBlock Text="Con questa opzione la X nasconde la finestra; per uscire usa il menu dell'icona tray."
                                       Foreground="#64748B"
                                       Margin="24,-8,0,14"
                                       TextWrapping="Wrap" />

                            <CheckBox x:Name="ShowNotificationsCheckBox"
                                      Content="Mostra notifiche tray"
                                      FontWeight="SemiBold"
                                      Margin="0,0,0,12"
                                      Checked="SettingsCheckBox_Changed"
                                      Unchecked="SettingsCheckBox_Changed" />
                            <TextBlock Text="Include nuovi driver disponibili, aggiornamenti dell'app e il primo avviso di passaggio al tray."
                                       Foreground="#64748B"
                                       Margin="24,-8,0,14"
                                       TextWrapping="Wrap" />

                            <CheckBox x:Name="CheckOnStartupCheckBox"
                                      Content="Controlla driver e aggiornamenti all'avvio"
                                      FontWeight="SemiBold"
                                      Checked="SettingsCheckBox_Changed"
                                      Unchecked="SettingsCheckBox_Changed" />
                            <TextBlock Text="Esegue una scansione completa e interroga Windows Update quando OmegaDrive si avvia."
                                       Foreground="#64748B"
                                       Margin="24,4,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="File impostazioni"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A" />
                            <TextBlock x:Name="SettingsPathText"
                                       Text="—"
                                       Foreground="#64748B"
                                       Margin="0,4,0,10"
                                       TextWrapping="Wrap" />
                            <WrapPanel>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Content="Apri cartella impostazioni"
                                        Click="OpenSettingsFolderButton_Click" />
                                <Button Style="{StaticResource SecondaryButton}"
                                        Content="Ripristina predefinite"
                                        Click="ResetSettingsButton_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Informazioni">
                <Grid Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="150"
                            Height="150"
                            Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="22"
                            Margin="0,0,22,0">
                        <Image Source="Assets/App.ico"
                               Width="112"
                               Height="112"
                               Stretch="Uniform" />
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="OmegaDrive"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A" />
                        <TextBlock Text="Drivers. Done right."
                                   Foreground="#64748B"
                                   Margin="0,4,0,16" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Versione"
                                       FontWeight="SemiBold"
                                       Margin="0,0,12,8" />
                            <TextBlock x:Name="AboutVersionText"
                                       Grid.Row="0"
                                       Grid.Column="1"
                                       Text="—"
                                       Margin="0,0,0,8" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Runtime / architettura"
                                       FontWeight="SemiBold"
                                       Margin="0,0,12,8" />
                            <TextBlock x:Name="AboutRuntimeText"
                                       Grid.Row="1"
                                       Grid.Column="1"
                                       Text="—"
                                       Margin="0,0,0,8" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Firma Authenticode"
                                       FontWeight="SemiBold"
                                       Margin="0,0,12,8" />
                            <TextBlock x:Name="AboutSignatureText"
                                       Grid.Row="2"
                                       Grid.Column="1"
                                       Text="—"
                                       Margin="0,0,0,8" />

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Text="Eseguibile"
                                       FontWeight="SemiBold"
                                       Margin="0,0,12,0" />
                            <TextBlock x:Name="AboutExecutablePathText"
                                       Grid.Row="3"
                                       Grid.Column="1"
                                       Text="—"
                                       TextWrapping="Wrap" />
                        </Grid>

                        <TextBlock Text="La voce Firma Authenticode indica la presenza di una firma incorporata nel file PE. La validazione della catena di fiducia resta responsabilità di Windows."
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16" />

                        <WrapPanel>
                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="Apri repository GitHub"
                                    Click="OpenRepositoryButton_Click" />
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="Copia informazioni"
                                    Click="CopyAboutButton_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="4"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,14,0,0">
            <StackPanel>
                <TextBlock x:Name="StatusText"
                           Text="Pronto."
                           Foreground="#334155"
                           Margin="0,0,0,7" />
                <ProgressBar x:Name="OperationProgress"
                             Minimum="0"
                             Maximum="100"
                             Height="8"
                             Value="0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
