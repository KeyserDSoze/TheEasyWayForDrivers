<Window x:Class="TheEasyWayForDrivers.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmegaDrive — Driver Manager"
        Icon="Assets/App.ico"
        Width="1260"
        Height="800"
        MinWidth="1040"
        MinHeight="650"
        Background="#F4F6F8"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0F6CBD" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0F6CBD" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="RowHeight" Value="38" />
            <Setter Property="ColumnHeaderHeight" Value="40" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0" />
            <Setter Property="SelectionMode" Value="Single" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#111827"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right"
                            HorizontalAlignment="Right">
                    <TextBlock x:Name="AppVersionText"
                               Foreground="#D1D5DB"
                               HorizontalAlignment="Right"
                               Text="App 0.0.0" />
                    <TextBlock x:Name="HeaderServiceText"
                               Foreground="#9CA3AF"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,0"
                               Text="Servizio: verifica in corso..." />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Border Width="58"
                            Height="58"
                            Background="White"
                            CornerRadius="14"
                            Margin="0,0,14,0">
                        <Image Source="Assets/App.ico"
                               Width="46"
                               Height="46"
                               Stretch="Uniform" />
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="OmegaDrive"
                                   Foreground="White"
                                   FontSize="26"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Gestisci i driver. Senza complicazioni."
                                   Foreground="#D1D5DB"
                                   FontSize="13"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="WINDOWS DRIVER MANAGER"
                                   Foreground="#60A5FA"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Solo il percorso guidato e visibile al primo avvio. -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
            <Button x:Name="AdvancedToggleButton"
                    Style="{StaticResource SecondaryButton}"
                    Content="Dettagli avanzati"
                    AutomationProperties.Name="Apri gli strumenti avanzati"
                    Click="AdvancedToggleButton_Click" />
            <WrapPanel x:Name="AdvancedActionsPanel" Visibility="Collapsed">
                <Button x:Name="ProblemsButton" Style="{StaticResource SecondaryButton}"
                        Content="Problemi hardware" Click="ProblemsButton_Click" />
                <Button x:Name="ScanButton" Style="{StaticResource SecondaryButton}"
                        Content="Scansiona dispositivi" Click="ScanButton_Click" />
                <Button x:Name="SearchUpdatesButton" Style="{StaticResource SecondaryButton}"
                        Content="Cerca driver" Click="SearchUpdatesButton_Click" />
                <ComboBox x:Name="DriverSearchModeComboBox"
                          Width="205" Height="36" Margin="0,0,8,8"
                          SelectedValuePath="Tag"
                          ToolTip="La ricerca approfondita include risultati avanzati che non vengono preselezionati.">
                    <ComboBoxItem Content="Ricerca consigliata" Tag="Recommended" />
                    <ComboBoxItem Content="Ricerca approfondita" Tag="Comprehensive" />
                </ComboBox>
                <Button x:Name="CheckAppUpdateButton" Style="{StaticResource SecondaryButton}"
                        Content="Controlla app" Click="CheckAppUpdateButton_Click" />
            </WrapPanel>
            <Button x:Name="ApplyAppUpdateButton" Style="{StaticResource PrimaryButton}"
                    Content="Aggiorna OmegaDrive" Visibility="Collapsed"
                    Click="ApplyAppUpdateButton_Click" />
            <Button x:Name="RebootButton" Style="{StaticResource PrimaryButton}"
                    Content="Riavvia Windows" Visibility="Collapsed"
                    Click="RebootButton_Click" />
        </WrapPanel>

        <Grid x:Name="SummaryGrid"
              Grid.Row="2"
              Visibility="Collapsed"
              Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <TextBlock Text="DISPOSITIVI"
                               Foreground="#64748B"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="DevicesCountText"
                               Text="—"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               Margin="0,5,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <TextBlock Text="DA CONTROLLARE"
                               Foreground="#64748B"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="AttentionCountText"
                               Text="—"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               Margin="0,5,0,0" />
                    <TextBlock x:Name="AttentionBreakdownText"
                               Text="Scansione non eseguita"
                               FontSize="11"
                               Foreground="#64748B"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <TextBlock Text="UPDATE DRIVER"
                               Foreground="#64748B"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="UpdatesCountText"
                               Text="—"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               Margin="0,5,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="SERVIZIO"
                               Foreground="#64748B"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ServiceHealthText"
                               Text="Verifica..."
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               Margin="0,5,0,0" />
                    <TextBlock x:Name="ServiceVersionCardText"
                               Text=""
                               Foreground="#64748B"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Simple first-run entry: no long technical lists before the scan. -->
        <ScrollViewer x:Name="HomePanel" Grid.Row="3"
                      VerticalScrollBarVisibility="Auto">
            <Border MaxWidth="850" HorizontalAlignment="Center"
                    Margin="16,36,16,16" Padding="42"
                    Background="White" BorderBrush="#E2E8F0"
                    BorderThickness="1" CornerRadius="16">
                <StackPanel>
                    <TextBlock Text="Il tuo PC, sotto controllo"
                               Foreground="#0F172A" FontSize="32"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="Controlla i dispositivi e cerca aggiornamenti in un solo passaggio."
                               Foreground="#475569" FontSize="16"
                               Margin="0,12,0,30" TextWrapping="Wrap" />
                    <Button x:Name="ScanAllButton"
                            Style="{StaticResource PrimaryButton}"
                            Content="Analizza il PC"
                            Padding="28,17" MinWidth="250" MinHeight="62"
                            FontSize="19" HorizontalAlignment="Left"
                            AutomationProperties.Name="Analizza il PC e cerca aggiornamenti driver"
                            Click="ScanAllButton_Click" />
                    <TextBlock x:Name="HomeScanStateText"
                               Text="Pronto per il controllo."
                               Margin="0,16,0,0" Foreground="#334155"
                               AutomationProperties.LiveSetting="Polite"
                               TextWrapping="Wrap" />
                    <TextBlock Text="L'analisi non installa driver. Potrai scegliere cosa aggiornare."
                               Foreground="#64748B" Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Results are a first-class page, not an invitation to navigate
             eight technical tabs. Virtualized list and persistent footer. -->
        <Grid x:Name="HomeResultsPanel" Grid.Row="3" Visibility="Collapsed"
              Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White"
                    BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="12" Padding="18" Margin="0,0,0,10">
                <DockPanel LastChildFill="True">
                    <Button x:Name="ResultsRescanButton" DockPanel.Dock="Right"
                            Style="{StaticResource SecondaryButton}"
                            Content="Nuova analisi" HorizontalAlignment="Right"
                            Click="ScanAllButton_Click" />
                    <StackPanel>
                        <TextBlock x:Name="HomeResultHeadline"
                                   Text="Risultati dell'analisi"
                                   Foreground="#0F172A" FontSize="23"
                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="HomeResultSummary"
                                   Foreground="#475569" Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="HomeSourceSummary"
                                   Foreground="#64748B" Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="HomeCaveatText"
                                   Foreground="#92400E" Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Background="White"
                    BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="10" Padding="10,8" Margin="0,0,0,8">
                <DockPanel LastChildFill="True">
                    <ComboBox x:Name="ResultFilterComboBox"
                              DockPanel.Dock="Right" Width="196" Height="35"
                              SelectedValuePath="Tag"
                              AutomationProperties.Name="Filtra aggiornamenti"
                              SelectionChanged="ResultFilterComboBox_SelectionChanged">
                        <ComboBoxItem Tag="normal" Content="Aggiornamenti normali" />
                        <ComboBoxItem Tag="recommended" Content="Consigliati" />
                        <ComboBoxItem Tag="optional" Content="Facoltativi" />
                        <ComboBoxItem Tag="advanced" Content="Avanzati / nascosti" />
                        <ComboBoxItem Tag="all" Content="Tutti i candidati" />
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Aggiornamenti disponibili"
                                   Foreground="#0F172A" FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="CompactUpdateCountText"
                                   Foreground="#0F6CBD" FontSize="16"
                                   FontWeight="SemiBold" Margin="10,0,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Grid.Row="2" Background="White" CornerRadius="10"
                    BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <ListView x:Name="CompactUpdatesList"
                              ItemsSource="{Binding CompactUpdatesView}"
                              BorderThickness="0" Background="Transparent"
                              HorizontalContentAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              AutomationProperties.Name="Risultati della ricerca driver">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E5E7EB"
                                        BorderThickness="0,0,0,1"
                                        Padding="12,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="35" />
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanQuickInstall}"
                                                  AutomationProperties.Name="Seleziona aggiornamento" />
                                        <Border Grid.Column="1" Width="36" Height="36"
                                                VerticalAlignment="Center" Background="#EFF6FF"
                                                CornerRadius="8">
                                            <TextBlock Text="WU" Foreground="#0F6CBD"
                                                       FontWeight="SemiBold" FontSize="13"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="2" Margin="12,0,14,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="#0F172A"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding CompactMetadata}"
                                                       FontSize="12" Foreground="#64748B"
                                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding AvailableVersionText}"
                                                       FontSize="12" Foreground="#475569"
                                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="3"
                                                Content="{Binding QuickInstallLabel}"
                                                Style="{StaticResource SecondaryButton}"
                                                VerticalAlignment="Center"
                                                MinWidth="96"
                                                Click="QuickUpdateButton_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="CompactEmptyStateText"
                               Text="Nessun aggiornamento in questa categoria."
                               Visibility="Collapsed"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#64748B"
                               FontSize="14" TextWrapping="Wrap"
                               Margin="20" />
                </Grid>
            </Border>
            <Border Grid.Row="3" Background="White"
                    BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="10" Padding="14,10" Margin="0,10,0,0">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <Button x:Name="CompactUpdateAllButton"
                                DockPanel.Dock="Right"
                                Content="Aggiorna tutto"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="180" Padding="18,12"
                                Margin="8,0,0,0"
                                AutomationProperties.Name="Aggiorna tutti i candidati ordinari Windows Update"
                                Click="CompactUpdateAllButton_Click" />
                        <Button x:Name="CompactUpdateSelectedButton"
                                DockPanel.Dock="Right"
                                Content="Aggiorna selezionati"
                                Style="{StaticResource SecondaryButton}"
                                Padding="14,12" Margin="8,0,0,0"
                                Click="CompactUpdateSelectedButton_Click" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="CompactSelectionSummaryText"
                                       Text="Solo driver Windows Update ordinari. Nessun OEM installato automaticamente."
                                       Foreground="#334155" FontSize="12"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Ogni installazione richiede conferma. Firmware e candidati avanzati/nascosti sono esclusi dalle azioni rapide."
                                       FontSize="11" Foreground="#64748B"
                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <Expander Header="Fonti controllate, versioni installate e dettagli"
                              Margin="0,8,0,0" Foreground="#334155">
                        <StackPanel Margin="4,10,4,2">
                            <TextBlock x:Name="HomeCoverageText"
                                       Foreground="#475569" TextWrapping="Wrap" />
                            <TextBlock x:Name="HomeInstalledDriverEvidenceText"
                                       Margin="0,10,0,0" Foreground="#475569"
                                       TextWrapping="Wrap" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="HomeUpdatesButton"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Elenco tecnico"
                                        Click="HomeUpdatesButton_Click" />
                                <Button x:Name="HomeProblemsButton"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Problemi dispositivi"
                                        Click="HomeProblemsButton_Click" />
                                <Button x:Name="HomeOemButton"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Fonti OEM"
                                        Click="HomeOemButton_Click" />
                            </WrapPanel>
                            <TextBlock Text="Una fonte OEM rilevata non equivale a un driver verificato. Per pacchetti vendor usa i canali ufficiali indicati nei dettagli."
                                       Foreground="#64748B" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
        </Grid>

        <TabControl x:Name="MainTabs"
                    Grid.Row="3"
                    Visibility="Collapsed"
                    Background="White">
            <TabItem x:Name="DriversTab" Header="Driver installati">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,0,10">
                        <DockPanel>
                            <TextBlock x:Name="FilteredDevicesCountText"
                                       DockPanel.Dock="Right"
                                       VerticalAlignment="Center"
                                       Foreground="#64748B"
                                       Margin="12,0,0,0"
                                       Text="Visualizzati 0 di 0" />

                            <WrapPanel>
                                <TextBox x:Name="DeviceSearchTextBox"
                                         Width="260"
                                         Margin="0,0,10,0"
                                         Padding="8,6"
                                         ToolTip="Cerca per dispositivo, produttore, provider, ID o fonte"
                                         TextChanged="DeviceSearchTextBox_TextChanged" />

                                <ComboBox x:Name="StatusFilterComboBox"
                                          Width="190"
                                          Margin="0,0,10,0"
                                          SelectedValuePath="Tag"
                                          SelectionChanged="DriverFilter_Changed">
                                    <ComboBoxItem Content="Tutti gli stati"
                                                  Tag="all" />
                                    <ComboBoxItem Content="Da controllare"
                                                  Tag="attention" />
                                    <ComboBoxItem Content="Problemi hardware"
                                                  Tag="hardware-problems" />
                                    <ComboBoxItem Content="Aggiornamento disponibile"
                                                  Tag="Aggiornamento disponibile" />
                                    <ComboBoxItem Content="Driver mancante"
                                                  Tag="Driver mancante" />
                                    <ComboBoxItem Content="Da verificare"
                                                  Tag="Da verificare" />
                                    <ComboBoxItem Content="Errore Windows"
                                                  Tag="Errore Windows" />
                                    <ComboBoxItem Content="OK"
                                                  Tag="OK" />
                                </ComboBox>

                                <ComboBox x:Name="SourceFilterComboBox"
                                          Width="180"
                                          SelectedValuePath="Tag"
                                          SelectionChanged="DriverFilter_Changed">
                                    <ComboBoxItem Content="Tutte le fonti"
                                                  Tag="all" />
                                    <ComboBoxItem Content="Windows Update"
                                                  Tag="Windows Update" />
                                    <ComboBoxItem Content="Intel"
                                                  Tag="Intel" />
                                    <ComboBoxItem Content="NVIDIA"
                                                  Tag="NVIDIA" />
                                    <ComboBoxItem Content="AMD"
                                                  Tag="AMD" />
                                    <ComboBoxItem Content="OEM del PC"
                                                  Tag="OEM" />
                                    <ComboBoxItem Content="Windows / OEM"
                                                  Tag="Windows / OEM" />
                                </ComboBox>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <DataGrid x:Name="DriversGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding DriversView}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              SelectionChanged="DriversGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Stato"
                                                    Width="175">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBackground}"
                                                CornerRadius="10"
                                                Padding="8,3"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="{Binding StatusForeground}"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Dispositivo"
                                                Binding="{Binding Name}"
                                                Width="2*" />
                            <DataGridTextColumn Header="Fonte consigliata"
                                                Binding="{Binding RecommendedSource}"
                                                Width="*" />
                            <DataGridTextColumn Header="Produttore"
                                                Binding="{Binding Manufacturer}"
                                                Width="*" />
                            <DataGridTextColumn Header="Driver installato"
                                                Binding="{Binding DriverVersion}"
                                                Width="*" />
                            <DataGridTextColumn Header="Update proposto"
                                                Binding="{Binding AvailableUpdateTitle}"
                                                Width="2*" />
                            <DataGridTextColumn Header="Data update"
                                                Binding="{Binding AvailableUpdateDate}"
                                                Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedItem.Name, ElementName=DriversGrid, TargetNullValue=Seleziona un dispositivo per visualizzare i dettagli.}"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A" />
                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Margin="0,0,18,0">
                                    <Run Text="Stato: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedItem.Status, ElementName=DriversGrid, TargetNullValue=—}" />
                                </TextBlock>
                                <TextBlock Margin="0,0,18,0">
                                    <Run Text="Fonte consigliata: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedItem.RecommendedSource, ElementName=DriversGrid, TargetNullValue=—}" />
                                </TextBlock>
                                <TextBlock Margin="0,0,18,0">
                                    <Run Text="Provider installato: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedItem.DriverProvider, ElementName=DriversGrid, TargetNullValue=—}" />
                                </TextBlock>
                                <TextBlock Margin="0,0,18,0">
                                    <Run Text="Versione: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedItem.DriverVersion, ElementName=DriversGrid, TargetNullValue=—}" />
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Codice Windows: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedItem.ConfigManagerErrorCode, ElementName=DriversGrid, TargetNullValue=—}" />
                                </TextBlock>
                            </WrapPanel>
                            <TextBlock Margin="0,5,0,0"
                                       TextWrapping="Wrap">
                                <Run Text="Dettaglio: " FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedItem.StatusDetail, ElementName=DriversGrid, TargetNullValue=—}" />
                            </TextBlock>
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                                <Run Text="Hardware ID: " FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedItem.HardwareIdsText, ElementName=DriversGrid, TargetNullValue=—}" />
                            </TextBlock>
                            <TextBlock Margin="0,3,0,0" TextWrapping="Wrap">
                                <Run Text="Compatible ID: " FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedItem.CompatibleIdsText, ElementName=DriversGrid, TargetNullValue=—}" />
                            </TextBlock>
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="#475569"
                                       TextWrapping="Wrap">
                                <Run Text="Identificazione hardware: " FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedItem.HardwareIdentityHint, ElementName=DriversGrid, TargetNullValue=—}" />
                            </TextBlock>
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="#0F6CBD"
                                       TextWrapping="Wrap">
                                <Run Text="Discovery+: " FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedItem.DiscoveryGuidance, ElementName=DriversGrid, TargetNullValue=—}" />
                            </TextBlock>
                            <TextBlock Margin="0,6,0,0"
                                       TextWrapping="Wrap">
                                <Run Text="Update Windows Update: " FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedItem.AvailableUpdateTitle, ElementName=DriversGrid, TargetNullValue=—}" />
                            </TextBlock>
                            <WrapPanel Margin="0,3,0,0">
                                <TextBlock Margin="0,0,18,0">
                                    <Run Text="Provider update: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedItem.AvailableUpdateProvider, ElementName=DriversGrid, TargetNullValue=—}" />
                                </TextBlock>
                                <TextBlock Margin="0,0,18,0">
                                    <Run Text="Modello: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedItem.AvailableUpdateModel, ElementName=DriversGrid, TargetNullValue=—}" />
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Data update: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedItem.AvailableUpdateDate, ElementName=DriversGrid, TargetNullValue=—}" />
                                </TextBlock>
                            </WrapPanel>
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="#64748B"
                                       TextTrimming="CharacterEllipsis">
                                <Run Text="Hardware ID associato: " FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedItem.MatchedHardwareId, ElementName=DriversGrid, TargetNullValue=—}" />
                            </TextBlock>
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="#64748B"
                                       TextWrapping="Wrap">
                                <Run Text="Qualità corrispondenza: " FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedItem.MatchEvidence, ElementName=DriversGrid, TargetNullValue=—}" />
                            </TextBlock>
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="#475569"
                                       TextWrapping="Wrap">
                                <Run Text="Valutazione Discovery+: " FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedItem.CandidateAssessment, ElementName=DriversGrid, TargetNullValue=—}" />
                            </TextBlock>
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="#64748B"
                                       TextTrimming="CharacterEllipsis">
                                <Run Text="Device ID: " FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedItem.DeviceId, ElementName=DriversGrid, TargetNullValue=—}" />
                            </TextBlock>
                            <TextBlock Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="#1E40AF">
                                <Run Text="Prossimo passo: " FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedItem.NextAction, ElementName=DriversGrid, TargetNullValue=Seleziona un dispositivo.}" />
                            </TextBlock>
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="DeepSearchForDeviceButton"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Ricerca approfondita del PC"
                                        Click="DeepSearchForDeviceButton_Click" />
                                <Button x:Name="CopySelectedHardwareIdButton"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Copia Hardware ID"
                                        Click="CopySelectedHardwareIdButton_Click" />
                                <Button x:Name="GoToOemSourcesButton"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Apri fonti ufficiali OEM"
                                        Click="GoToOemSourcesButton_Click" />
                            </WrapPanel>
                            <Button x:Name="InstallDeviceUpdateButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="Installa update di questo dispositivo"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0"
                                    IsEnabled="False"
                                    Click="InstallDeviceUpdateButton_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="UpdatesTab"
                     Header="Aggiornamenti disponibili">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,0,10">
                        <DockPanel>
                            <TextBlock x:Name="FilteredUpdatesCountText"
                                       DockPanel.Dock="Right"
                                       VerticalAlignment="Center"
                                       Foreground="#64748B"
                                       Margin="12,0,0,0"
                                       Text="Visualizzati 0 di 0" />

                            <WrapPanel>
                                <TextBox x:Name="UpdateSearchTextBox"
                                         Width="290"
                                         Margin="0,0,10,0"
                                         Padding="8,6"
                                         ToolTip="Cerca aggiornamento, provider, modello, classe o hardware ID"
                                         TextChanged="UpdateSearchTextBox_TextChanged" />

                                <ComboBox x:Name="UpdateSelectionFilterComboBox"
                                          Width="180"
                                          Margin="0,0,10,0"
                                          SelectedValuePath="Tag"
                                          SelectionChanged="UpdateFilter_Changed">
                                    <ComboBoxItem Content="Tutti gli update"
                                                  Tag="all" />
                                    <ComboBoxItem Content="Solo selezionati"
                                                  Tag="selected" />
                                    <ComboBoxItem Content="Solo non selezionati"
                                                  Tag="unselected" />
                                </ComboBox>

                                <ComboBox x:Name="UpdateKindFilterComboBox"
                                          Width="170"
                                          SelectedValuePath="Tag"
                                          SelectionChanged="UpdateFilter_Changed">
                                    <ComboBoxItem Content="Tutti i tipi"
                                                  Tag="all" />
                                    <ComboBoxItem Content="Consigliati"
                                                  Tag="Consigliato" />
                                    <ComboBoxItem Content="Facoltativi"
                                                  Tag="Facoltativo" />
                                    <ComboBoxItem Content="Avanzati + nascosti"
                                                  Tag="advanced-all" />
                                    <ComboBoxItem Content="Solo avanzati"
                                                  Tag="Avanzato" />
                                    <ComboBoxItem Content="Solo nascosti"
                                                  Tag="Nascosto" />
                                </ComboBox>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1"
                          Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0"
                                Click="ShowRecommendedUpdatesButton_Click">
                            <StackPanel>
                                <TextBlock Text="Consigliati per il PC"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A" />
                                <TextBlock x:Name="RecommendedUpdatesCountText"
                                           Text="0"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="#0F6CBD"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0"
                                Click="ShowOptionalUpdatesButton_Click">
                            <StackPanel>
                                <TextBlock Text="Facoltativi"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A" />
                                <TextBlock x:Name="OptionalUpdatesCountText"
                                           Text="0"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="#475569"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0"
                                Click="ShowOemSourcesButton_Click">
                            <StackPanel>
                                <TextBlock Text="Fonti OEM"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A" />
                                <TextBlock x:Name="OemSourcesCountText"
                                           Text="0"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="#475569"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="3"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0"
                                Click="ShowAdvancedUpdatesButton_Click">
                            <StackPanel>
                                <TextBlock Text="Avanzati"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A" />
                                <TextBlock x:Name="AdvancedUpdatesCountText"
                                           Text="0"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="#B45309"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <DataGrid x:Name="UpdatesGrid"
                              Grid.Row="2"
                              ItemsSource="{Binding DriverUpdatesView}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Installa"
                                                    Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="Auto" />
                            <DataGridTextColumn Header="Tipo"
                                                Binding="{Binding KindText}"
                                                IsReadOnly="True"
                                                Width="110" />
                            <DataGridTextColumn Header="Aggiornamento"
                                                Binding="{Binding Title}"
                                                IsReadOnly="True"
                                                Width="3*" />
                            <DataGridTextColumn Header="Fonte ricerca"
                                                Binding="{Binding SearchSource}"
                                                IsReadOnly="True"
                                                Width="175" />
                            <DataGridTextColumn Header="Provider"
                                                Binding="{Binding Provider}"
                                                IsReadOnly="True"
                                                Width="*" />
                            <DataGridTextColumn Header="Modello"
                                                Binding="{Binding Model}"
                                                IsReadOnly="True"
                                                Width="*" />
                            <DataGridTextColumn Header="Classe"
                                                Binding="{Binding DriverClass}"
                                                IsReadOnly="True"
                                                Width="*" />
                            <DataGridTextColumn Header="Data driver"
                                                Binding="{Binding DriverDateText}"
                                                IsReadOnly="True"
                                                Width="Auto" />
                            <DataGridTextColumn Header="Dimensione"
                                                Binding="{Binding SizeText}"
                                                IsReadOnly="True"
                                                Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3"
                                Margin="0,10,0,0">
                        <TextBlock Foreground="#64748B"
                                   Margin="0,0,0,8"
                                   TextWrapping="Wrap"
                                   Text="Fonti OEM = canali ufficiali applicabili al PC, non numero di driver già rilevati. I risultati avanzati/nascosti non sono preselezionati." />
                        <WrapPanel>
                        <Button x:Name="SelectAllUpdatesButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="Seleziona tutti"
                                Click="SelectAllUpdatesButton_Click" />
                        <Button x:Name="DeselectAllUpdatesButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="Deseleziona tutti"
                                Click="DeselectAllUpdatesButton_Click" />
                        <Button x:Name="InstallSelectedButton"
                                Style="{StaticResource PrimaryButton}"
                                Content="Scarica e installa selezionati"
                                Click="InstallSelectedButton_Click" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="#64748B"
                                   Text="L'installazione parte solo dopo una tua azione esplicita." />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="OemProvidersTab"
                     Header="Provider OEM">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,10">
                        <TextBlock Text="Provider OEM ufficiali"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   Text="Windows Update resta la fonte automatica integrata. OmegaDrive rileva Intel, NVIDIA, AMD e il produttore del PC (Dell, Lenovo, HP, ASUS, Acer, MSI, GIGABYTE, Surface), usando solo flussi ufficiali." />
                    </StackPanel>

                    <DataGrid x:Name="OemProvidersGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding OemProviders}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Provider"
                                                Binding="{Binding DisplayName}"
                                                Width="*" />
                            <DataGridTextColumn Header="Dispositivi rilevati"
                                                Binding="{Binding DetectedDeviceCount}"
                                                Width="Auto" />
                            <DataGridTextColumn Header="Modello PC"
                                                Binding="{Binding SystemIdentity}"
                                                Width="*" />
                            <DataGridTextColumn Header="Integrazione"
                                                Binding="{Binding IntegrationMode}"
                                                Width="*" />
                            <DataGridTextColumn Header="Companion"
                                                Binding="{Binding CompanionStatus}"
                                                Width="*" />
                            <DataGridTextColumn Header="Stato"
                                                Binding="{Binding Message}"
                                                Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <Expander Header="HP — catalogo SoftPaq ufficiale (CMSL installata)"
                                  Margin="0,0,0,8">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Foreground="#475569"
                                           TextWrapping="Wrap"
                                           Text="Richiede HP CMSL già installata. Interroga il catalogo Driver del PC HP e la versione Windows locale; non installa driver, BIOS o firmware." />
                                <Button x:Name="ReadHpSoftpaqCatalogButton"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Consulta SoftPaq HP"
                                        Click="ReadHpSoftpaqCatalogButton_Click"
                                        HorizontalAlignment="Left"
                                        Margin="0,6,0,0" />
                                <TextBox x:Name="HpCatalogResultsTextBox"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Height="85"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="Nessuna consultazione eseguita." />
                            </StackPanel>
                        </Expander>
                        <Expander Header="Lenovo — catalogo ufficiale (modulo già installato)"
                                  Margin="0,0,0,8">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="#475569"
                                           Text="Inserisci il MachineType Lenovo di 4 caratteri (non il seriale). Usa Lenovo.Client.Scripting ufficiale; nessun driver viene installato." />
                                <WrapPanel Margin="0,6,0,0">
                                    <TextBox x:Name="LenovoMachineTypeTextBox"
                                             Width="115"
                                             MaxLength="4"
                                             Margin="0,0,8,0"
                                             ToolTip="MachineType Lenovo, ad esempio 21HD." />
                                    <Button x:Name="ReadLenovoDriverCatalogButton"
                                            Style="{StaticResource SecondaryButton}"
                                            Content="Consulta Lenovo"
                                            Click="ReadLenovoDriverCatalogButton_Click" />
                                </WrapPanel>
                                <TextBox x:Name="LenovoCatalogResultsTextBox"
                                         Text="Nessuna consultazione eseguita."
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Height="85"
                                         VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Expander>
                        <TextBlock Margin="0,0,0,8"
                                   TextWrapping="Wrap"
                                   Foreground="#475569"
                                   Text="{Binding SelectedItem.SupportInstructions, ElementName=OemProvidersGrid, TargetNullValue=Seleziona un provider per le istruzioni di ricerca ufficiale.}" />
                        <WrapPanel>
                        <Button x:Name="RefreshOemProvidersButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="Aggiorna provider OEM"
                                Click="RefreshOemProvidersButton_Click" />
                        <Button x:Name="OpenSelectedOemProviderButton"
                                Style="{StaticResource PrimaryButton}"
                                Content="Apri supporto ufficiale"
                                Click="OpenSelectedOemProviderButton_Click" />
                        <Button x:Name="OpenSurfaceDownloadCenterButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="Pacchetti Surface Microsoft"
                                ToolTip="Apre il catalogo Microsoft del modello identificato. I pacchetti MSI possono includere firmware."
                                Click="OpenSurfaceDownloadCenterButton_Click" />
                        <Button x:Name="ReadDellDriverCatalogButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="Consulta catalogo Dell"
                                ToolTip="Legge soltanto metadati Dell Command Deploy. Seleziona prima il provider del PC Dell."
                                Click="ReadDellDriverCatalogButton_Click" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="#64748B"
                                   Text="Cataloghi OEM: metadati informativi, non installazioni." />
                        </WrapPanel>
                        <ScrollViewer MaxHeight="140"
                                      Margin="0,7,0,0"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="DellCatalogResultsText"
                                       Foreground="#475569"
                                       TextWrapping="Wrap"
                                       Text="Dell: seleziona il provider di un PC Dell e consulta i Driver Pack di deployment ufficiali. Per driver individuali usa il portale del produttore." />
                        </ScrollViewer>
                        <Expander Header="Fonti e interfacce OEM documentate (15 produttori)"
                                  Margin="0,8,0,0"
                                  ToolTip="Cataloghi, utility locali e supporto ufficiale sono capacità distinte.">
                            <DataGrid ItemsSource="{Binding OemCatalogSources}"
                                      Height="180"
                                      Margin="0,6,0,0"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Produttore"
                                                        Binding="{Binding Vendor}" Width="*" />
                                    <DataGridTextColumn Header="Tipo integrazione"
                                                        Binding="{Binding Access}" Width="*" />
                                    <DataGridTextColumn Header="Limitazioni"
                                                        Binding="{Binding Limitations}" Width="3*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Discovery+">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock FontSize="18" FontWeight="SemiBold"
                                   Text="Risultati Discovery+ per sorgente" />
                        <WrapPanel Margin="0,8,0,2">
                            <Button x:Name="InspectInfButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Analizza INF e integrità"
                                    ToolTip="Calcola SHA-256 e consulta la firma CAT di Windows; nessuna installazione."
                                    Click="InspectInfButton_Click" />
                            <TextBlock Margin="10,0,5,0"
                                       VerticalAlignment="Center"
                                       Foreground="#475569"
                                       Text="SHA-256 INF atteso (facoltativo):" />
                            <TextBox x:Name="ExpectedInfSha256TextBox"
                                     Width="270"
                                     MaxLength="64"
                                     ToolTip="Copia il digest SHA-256 pubblicato dal produttore da una fonte attendibile. Senza digest esterno l'impronta è solo informativa." />
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#64748B"
                                       Text="Nessuna installazione da Discovery+." />
                        </WrapPanel>
                        <Button x:Name="InspectOemArchiveButton"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left"
                                Margin="0,6,0,4"
                                Content="Ispeziona archivio OEM locale"
                                ToolTip="Solo indice ZIP, CAB/MSI/EXE non estratti. Nessun download o installazione."
                                Click="InspectOemArchiveButton_Click" />
                        <ScrollViewer MaxHeight="155" Margin="0,3,0,7"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="OemArchiveResultsText"
                                       Foreground="#475569" TextWrapping="Wrap"
                                       Text="Archivio OEM non analizzato. Analisi statica e non verificata." />
                        </ScrollViewer>
                        <Button x:Name="AuditPackageFilesButton"
                                Style="{StaticResource SecondaryButton}"
                                IsEnabled="False"
                                HorizontalAlignment="Left"
                                Margin="0,6,0,4"
                                Content="Verifica file SYS/DLL/INF nella cartella"
                                ToolTip="Richiede INF e CAT locali e Windows SDK SignTool. Verifica parziale in sola lettura."
                                Click="AuditPackageFilesButton_Click" />
                        <ScrollViewer MaxHeight="175"
                                      Margin="0,3,0,7"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="PayloadAuditResultsText"
                                       Foreground="#475569"
                                       TextWrapping="Wrap"
                                       Text="Audit file non ancora eseguito. Nessuna installazione OEM." />
                        </ScrollViewer>
                        <ScrollViewer MaxHeight="190"
                                      Margin="0,3,0,5"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="InfEvidenceText"
                                       Foreground="#475569"
                                       TextWrapping="Wrap"
                                       Text="INF: non analizzato. Seleziona prima un dispositivo per confrontarlo." />
                        </ScrollViewer>
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="#64748B"
                                   Margin="0,0,0,5"
                                   Text="Membership INF nel CAT: richiede Microsoft Windows SDK SignTool già installato. Non verifica l'intero pacchetto." />
                        <CheckBox x:Name="DiscoveryDeviceOnlyCheckBox"
                                  Margin="0,8,0,4"
                                  Content="Solo candidati Windows Update del dispositivo selezionato"
                                  ToolTip="Seleziona prima un dispositivo in Driver installati. I pacchetti OEM non hanno ancora evidenza per-device."
                                  Checked="DiscoveryDeviceFilter_Changed"
                                  Unchecked="DiscoveryDeviceFilter_Changed" />
                        <TextBlock Margin="0,4,0,0" Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   Text="Questa vista mostra i risultati WUA dell'ultima ricerca e i metadati OEM consultati in questa sessione. I pacchetti OEM non sono installabili da qui. Lenovo, HP e Dell sono metadati informativi OEM, non driver automaticamente installabili." />
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <TextBlock x:Name="DiscoveryAssessmentText"
                                   Margin="0,0,0,7"
                                   Foreground="#334155"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Text="Seleziona un risultato per vedere la valutazione." />
                        <DataGrid x:Name="DiscoveryResultsGrid"
                                  Height="370"
                                  SelectionChanged="DiscoveryResultsGrid_SelectionChanged"
                                  ItemsSource="{Binding DiscoveryResultsView}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Stato" Binding="{Binding VerificationLabel}" Width="175" />
                            <DataGridTextColumn Header="Tipo" Binding="{Binding KindLabel}" Width="180" />
                            <DataGridTextColumn Header="Fonte" Binding="{Binding Source}" Width="140" />
                            <DataGridTextColumn Header="Pacchetto / Driver" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="Versione" Binding="{Binding Version}" Width="90" />
                            <DataGridTextColumn Header="Evidenza" Binding="{Binding Evidence}" Width="2*" />
                            <DataGridTextColumn Header="Limiti / Prossima azione" Binding="{Binding Guidance}" Width="2*" />
                        </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Cronologia">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="Esporta CSV"
                                    Click="ExportInstallHistoryButton_Click" />
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="Aggiorna cronologia"
                                    Click="RefreshInstallHistoryButton_Click" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Cronologia installazioni richieste"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Esito complessivo riferito dal servizio. Non certifica il successo di ciascun driver. Ultimi 200 eventi sul PC locale."
                                       Foreground="#64748B"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBox x:Name="HistorySearchTextBox"
                                 Width="290"
                                 Padding="8,6"
                                 Margin="0,0,10,0"
                                 ToolTip="Cerca nome driver, esito o messaggio"
                                 TextChanged="HistorySearchTextBox_TextChanged" />
                        <ComboBox x:Name="HistoryOutcomeFilterComboBox"
                                  Width="210"
                                  SelectedValuePath="Tag"
                                  SelectionChanged="HistoryFilter_Changed"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Tutti gli eventi" Tag="all" />
                            <ComboBoxItem Content="Batch riusciti" Tag="succeeded" />
                            <ComboBoxItem Content="Batch non riusciti" Tag="failed" />
                            <ComboBoxItem Content="Operazioni interrotte" Tag="interrupted" />
                            <ComboBoxItem Content="Riavvio richiesto" Tag="reboot" />
                        </ComboBox>
                    </WrapPanel>
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding InstallHistoryView}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data/ora UTC"
                                                Binding="{Binding TimestampUtc, StringFormat=yyyy-MM-dd HH:mm}"
                                                Width="155" />
                            <DataGridTextColumn Header="Driver richiesti"
                                                Binding="{Binding DriverTitles}"
                                                Width="3*" />
                            <DataGridTextColumn Header="Esito batch"
                                                Binding="{Binding Outcome}"
                                                Width="*" />
                            <DataGridCheckBoxColumn Header="Riavvio"
                                                    Binding="{Binding RebootRequired}"
                                                    Width="75" />
                            <DataGridTextColumn Header="Messaggio del servizio"
                                                Binding="{Binding Message}"
                                                Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Diagnostica">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0"
                               Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal">
                            <Button x:Name="RefreshDiagnosticsButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Aggiorna diagnostica"
                                    Click="RefreshDiagnosticsButton_Click" />
                            <Button x:Name="CopyDiagnosticsButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Copia log"
                                    Click="CopyDiagnosticsButton_Click" />
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Servizio privilegiato"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Ultime informazioni e fino a 200 righe del log corrente."
                                       Foreground="#64748B"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <WrapPanel Grid.Row="1"
                               Margin="0,0,0,10">
                        <TextBlock Margin="0,0,20,0">
                            <Run Text="Versione: " FontWeight="SemiBold" />
                            <Run x:Name="ServiceVersionText" Text="—" />
                        </TextBlock>
                        <TextBlock Margin="0,0,20,0">
                            <Run Text="Avviato: " FontWeight="SemiBold" />
                            <Run x:Name="ServiceStartedText" Text="—" />
                        </TextBlock>
                        <TextBlock>
                            <Run Text="Log: " FontWeight="SemiBold" />
                            <Run x:Name="ServiceLogPathText" Text="—" />
                        </TextBlock>
                    </WrapPanel>

                    <TextBox x:Name="DiagnosticsLogTextBox"
                             Grid.Row="2"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             FontSize="12"
                             Background="#0F172A"
                             Foreground="#E2E8F0"
                             BorderThickness="0"
                             Padding="12"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Text="Nessun dato diagnostico caricato." />
                </Grid>
            </TabItem>

            <TabItem Header="Impostazioni">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,14">
                        <TextBlock Text="Comportamento applicazione"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A" />
                        <TextBlock Text="Le preferenze vengono applicate subito e salvate per il tuo profilo Windows."
                                   Foreground="#64748B"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox x:Name="StartWithWindowsCheckBox"
                                      Content="Avvia OmegaDrive con Windows"
                                      FontWeight="SemiBold"
                                      Margin="0,0,0,12"
                                      Checked="SettingsCheckBox_Changed"
                                      Unchecked="SettingsCheckBox_Changed" />
                            <TextBlock Text="Modifica la voce di avvio automatico del tuo profilo Windows."
                                       Foreground="#64748B"
                                       Margin="24,-8,0,14" />

                            <CheckBox x:Name="MinimizeToTrayCheckBox"
                                      Content="Minimizza nell'area di notifica"
                                      FontWeight="SemiBold"
                                      Margin="0,0,0,12"
                                      Checked="SettingsCheckBox_Changed"
                                      Unchecked="SettingsCheckBox_Changed" />
                            <TextBlock Text="Quando minimizzi la finestra, l'app resta attiva nel tray."
                                       Foreground="#64748B"
                                       Margin="24,-8,0,14" />

                            <CheckBox x:Name="CloseToTrayCheckBox"
                                      Content="Chiudi nel tray invece di terminare l'app"
                                      FontWeight="SemiBold"
                                      Margin="0,0,0,12"
                                      Checked="SettingsCheckBox_Changed"
                                      Unchecked="SettingsCheckBox_Changed" />
                            <TextBlock Text="Con questa opzione la X nasconde la finestra; per uscire usa il menu dell'icona tray."
                                       Foreground="#64748B"
                                       Margin="24,-8,0,14"
                                       TextWrapping="Wrap" />

                            <CheckBox x:Name="ShowNotificationsCheckBox"
                                      Content="Mostra notifiche tray"
                                      FontWeight="SemiBold"
                                      Margin="0,0,0,12"
                                      Checked="SettingsCheckBox_Changed"
                                      Unchecked="SettingsCheckBox_Changed" />
                            <TextBlock Text="Include nuovi driver disponibili, aggiornamenti dell'app e il primo avviso di passaggio al tray."
                                       Foreground="#64748B"
                                       Margin="24,-8,0,14"
                                       TextWrapping="Wrap" />

                            <CheckBox x:Name="CheckOnStartupCheckBox"
                                      Content="Controlla driver e aggiornamenti all'avvio"
                                      FontWeight="SemiBold"
                                      Checked="SettingsCheckBox_Changed"
                                      Unchecked="SettingsCheckBox_Changed" />
                            <TextBlock Text="Esegue una scansione completa e interroga Windows Update quando OmegaDrive si avvia."
                                       Foreground="#64748B"
                                       Margin="24,4,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="File impostazioni"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A" />
                            <TextBlock x:Name="SettingsPathText"
                                       Text="—"
                                       Foreground="#64748B"
                                       Margin="0,4,0,10"
                                       TextWrapping="Wrap" />
                            <WrapPanel>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Content="Apri cartella impostazioni"
                                        Click="OpenSettingsFolderButton_Click" />
                                <Button Style="{StaticResource SecondaryButton}"
                                        Content="Ripristina predefinite"
                                        Click="ResetSettingsButton_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Informazioni">
                <Grid Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="150"
                            Height="150"
                            Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="22"
                            Margin="0,0,22,0">
                        <Image Source="Assets/App.ico"
                               Width="112"
                               Height="112"
                               Stretch="Uniform" />
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="OmegaDrive"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A" />
                        <TextBlock Text="Drivers. Done right."
                                   Foreground="#64748B"
                                   Margin="0,4,0,16" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Versione"
                                       FontWeight="SemiBold"
                                       Margin="0,0,12,8" />
                            <TextBlock x:Name="AboutVersionText"
                                       Grid.Row="0"
                                       Grid.Column="1"
                                       Text="—"
                                       Margin="0,0,0,8" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Runtime / architettura"
                                       FontWeight="SemiBold"
                                       Margin="0,0,12,8" />
                            <TextBlock x:Name="AboutRuntimeText"
                                       Grid.Row="1"
                                       Grid.Column="1"
                                       Text="—"
                                       Margin="0,0,0,8" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Firma Authenticode"
                                       FontWeight="SemiBold"
                                       Margin="0,0,12,8" />
                            <TextBlock x:Name="AboutSignatureText"
                                       Grid.Row="2"
                                       Grid.Column="1"
                                       Text="—"
                                       Margin="0,0,0,8" />

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Text="Eseguibile"
                                       FontWeight="SemiBold"
                                       Margin="0,0,12,0" />
                            <TextBlock x:Name="AboutExecutablePathText"
                                       Grid.Row="3"
                                       Grid.Column="1"
                                       Text="—"
                                       TextWrapping="Wrap" />
                        </Grid>

                        <TextBlock Text="La voce Firma Authenticode indica la presenza di una firma incorporata nel file PE. La validazione della catena di fiducia resta responsabilità di Windows."
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16" />

                        <WrapPanel>
                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="Apri repository GitHub"
                                    Click="OpenRepositoryButton_Click" />
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="Copia informazioni"
                                    Click="CopyAboutButton_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="4"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,14,0,0">
            <StackPanel>
                <TextBlock x:Name="StatusText"
                           Text="Pronto."
                           Foreground="#334155"
                           Margin="0,0,0,7" />
                <ProgressBar x:Name="OperationProgress"
                             Minimum="0"
                             Maximum="100"
                             Height="8"
                             Value="0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
