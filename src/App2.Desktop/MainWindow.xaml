<Window x:Class="TheEasyWayForDrivers.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TheEasyWayForDrivers"
        Width="1260"
        Height="800"
        MinWidth="1040"
        MinHeight="650"
        Background="#F4F6F8"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0F6CBD" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0F6CBD" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#111827"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right"
                            HorizontalAlignment="Right">
                    <TextBlock x:Name="AppVersionText"
                               Foreground="#D1D5DB"
                               HorizontalAlignment="Right"
                               Text="App 0.0.0" />
                    <TextBlock x:Name="HeaderServiceText"
                               Foreground="#9CA3AF"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,0"
                               Text="Servizio: verifica in corso..." />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="TheEasyWayForDrivers"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Driver Windows sotto controllo, senza installazioni automatiche."
                               Foreground="#D1D5DB"
                               FontSize="13"
                               Margin="0,5,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <WrapPanel Grid.Row="1"
                   Margin="0,0,0,6">
            <Button x:Name="ScanAllButton"
                    Style="{StaticResource PrimaryButton}"
                    Content="Controlla tutto"
                    Click="ScanAllButton_Click" />
            <Button x:Name="ScanButton"
                    Style="{StaticResource SecondaryButton}"
                    Content="Scansiona dispositivi"
                    Click="ScanButton_Click" />
            <Button x:Name="SearchUpdatesButton"
                    Style="{StaticResource SecondaryButton}"
                    Content="Cerca aggiornamenti"
                    Click="SearchUpdatesButton_Click" />
            <Button x:Name="CheckAppUpdateButton"
                    Style="{StaticResource SecondaryButton}"
                    Content="Controlla app"
                    Click="CheckAppUpdateButton_Click" />
            <Button x:Name="ApplyAppUpdateButton"
                    Style="{StaticResource PrimaryButton}"
                    Content="Aggiorna applicazione"
                    Visibility="Collapsed"
                    Click="ApplyAppUpdateButton_Click" />
            <Button x:Name="RebootButton"
                    Style="{StaticResource PrimaryButton}"
                    Content="Riavvia Windows"
                    Visibility="Collapsed"
                    Click="RebootButton_Click" />
        </WrapPanel>

        <Grid Grid.Row="2"
              Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <TextBlock Text="DISPOSITIVI"
                               Foreground="#64748B"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="DevicesCountText"
                               Text="—"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               Margin="0,5,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <TextBlock Text="DA CONTROLLARE"
                               Foreground="#64748B"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="AttentionCountText"
                               Text="—"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               Margin="0,5,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <TextBlock Text="UPDATE DRIVER"
                               Foreground="#64748B"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="UpdatesCountText"
                               Text="—"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               Margin="0,5,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="SERVIZIO"
                               Foreground="#64748B"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ServiceHealthText"
                               Text="Verifica..."
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               Margin="0,5,0,0" />
                    <TextBlock x:Name="ServiceVersionCardText"
                               Text=""
                               Foreground="#64748B"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <TabControl Grid.Row="3"
                    Background="White">
            <TabItem Header="Driver installati">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,0,10">
                        <DockPanel>
                            <TextBlock x:Name="FilteredDevicesCountText"
                                       DockPanel.Dock="Right"
                                       VerticalAlignment="Center"
                                       Foreground="#64748B"
                                       Margin="12,0,0,0"
                                       Text="Visualizzati 0 di 0" />

                            <WrapPanel>
                                <TextBox x:Name="DeviceSearchTextBox"
                                         Width="260"
                                         Margin="0,0,10,0"
                                         Padding="8,6"
                                         ToolTip="Cerca per dispositivo, produttore, provider, ID o fonte"
                                         TextChanged="DeviceSearchTextBox_TextChanged" />

                                <ComboBox x:Name="StatusFilterComboBox"
                                          Width="190"
                                          Margin="0,0,10,0"
                                          SelectedValuePath="Tag"
                                          SelectionChanged="DriverFilter_Changed">
                                    <ComboBoxItem Content="Tutti gli stati"
                                                  Tag="all" />
                                    <ComboBoxItem Content="Da controllare"
                                                  Tag="attention" />
                                    <ComboBoxItem Content="Aggiornamento disponibile"
                                                  Tag="Aggiornamento disponibile" />
                                    <ComboBoxItem Content="Driver mancante"
                                                  Tag="Driver mancante" />
                                    <ComboBoxItem Content="Errore Windows"
                                                  Tag="Errore Windows" />
                                    <ComboBoxItem Content="OK"
                                                  Tag="OK" />
                                </ComboBox>

                                <ComboBox x:Name="SourceFilterComboBox"
                                          Width="180"
                                          SelectedValuePath="Tag"
                                          SelectionChanged="DriverFilter_Changed">
                                    <ComboBoxItem Content="Tutte le fonti"
                                                  Tag="all" />
                                    <ComboBoxItem Content="Windows Update"
                                                  Tag="Windows Update" />
                                    <ComboBoxItem Content="Intel"
                                                  Tag="Intel" />
                                    <ComboBoxItem Content="NVIDIA"
                                                  Tag="NVIDIA" />
                                    <ComboBoxItem Content="AMD"
                                                  Tag="AMD" />
                                    <ComboBoxItem Content="OEM del PC"
                                                  Tag="OEM" />
                                    <ComboBoxItem Content="Windows / OEM"
                                                  Tag="Windows / OEM" />
                                </ComboBox>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <DataGrid x:Name="DriversGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding DriversView}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Stato"
                                                    Width="175">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBackground}"
                                                CornerRadius="10"
                                                Padding="8,3"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="{Binding StatusForeground}"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Dispositivo"
                                                Binding="{Binding Name}"
                                                Width="2*" />
                            <DataGridTextColumn Header="Fonte consigliata"
                                                Binding="{Binding RecommendedSource}"
                                                Width="*" />
                            <DataGridTextColumn Header="Produttore"
                                                Binding="{Binding Manufacturer}"
                                                Width="*" />
                            <DataGridTextColumn Header="Driver installato"
                                                Binding="{Binding DriverVersion}"
                                                Width="*" />
                            <DataGridTextColumn Header="Update proposto"
                                                Binding="{Binding AvailableUpdateTitle}"
                                                Width="2*" />
                            <DataGridTextColumn Header="Data update"
                                                Binding="{Binding AvailableUpdateDate}"
                                                Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedItem.Name, ElementName=DriversGrid, TargetNullValue=Seleziona un dispositivo per visualizzare i dettagli.}"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A" />
                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Margin="0,0,18,0">
                                    <Run Text="Stato: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedItem.Status, ElementName=DriversGrid, TargetNullValue=—}" />
                                </TextBlock>
                                <TextBlock Margin="0,0,18,0">
                                    <Run Text="Fonte consigliata: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedItem.RecommendedSource, ElementName=DriversGrid, TargetNullValue=—}" />
                                </TextBlock>
                                <TextBlock Margin="0,0,18,0">
                                    <Run Text="Provider installato: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedItem.DriverProvider, ElementName=DriversGrid, TargetNullValue=—}" />
                                </TextBlock>
                                <TextBlock Margin="0,0,18,0">
                                    <Run Text="Versione: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedItem.DriverVersion, ElementName=DriversGrid, TargetNullValue=—}" />
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Codice Windows: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedItem.ConfigManagerErrorCode, ElementName=DriversGrid, TargetNullValue=—}" />
                                </TextBlock>
                            </WrapPanel>
                            <TextBlock Margin="0,5,0,0"
                                       TextWrapping="Wrap">
                                <Run Text="Dettaglio: " FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedItem.StatusDetail, ElementName=DriversGrid, TargetNullValue=—}" />
                            </TextBlock>
                            <TextBlock Margin="0,6,0,0"
                                       TextWrapping="Wrap">
                                <Run Text="Update Windows Update: " FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedItem.AvailableUpdateTitle, ElementName=DriversGrid, TargetNullValue=—}" />
                            </TextBlock>
                            <WrapPanel Margin="0,3,0,0">
                                <TextBlock Margin="0,0,18,0">
                                    <Run Text="Provider update: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedItem.AvailableUpdateProvider, ElementName=DriversGrid, TargetNullValue=—}" />
                                </TextBlock>
                                <TextBlock Margin="0,0,18,0">
                                    <Run Text="Modello: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedItem.AvailableUpdateModel, ElementName=DriversGrid, TargetNullValue=—}" />
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Data update: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedItem.AvailableUpdateDate, ElementName=DriversGrid, TargetNullValue=—}" />
                                </TextBlock>
                            </WrapPanel>
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="#64748B"
                                       TextTrimming="CharacterEllipsis">
                                <Run Text="Hardware ID associato: " FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedItem.MatchedHardwareId, ElementName=DriversGrid, TargetNullValue=—}" />
                            </TextBlock>
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="#64748B"
                                       TextTrimming="CharacterEllipsis">
                                <Run Text="Device ID: " FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedItem.DeviceId, ElementName=DriversGrid, TargetNullValue=—}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Aggiornamenti disponibili">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Bottom"
                                Orientation="Horizontal"
                                Margin="0,10,0,0">
                        <Button x:Name="InstallSelectedButton"
                                Style="{StaticResource PrimaryButton}"
                                Content="Scarica e installa selezionati"
                                Click="InstallSelectedButton_Click" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="#64748B"
                                   Text="Vengono installati solo gli aggiornamenti selezionati." />
                    </StackPanel>

                    <DataGrid x:Name="UpdatesGrid"
                              ItemsSource="{Binding DriverUpdates}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Installa"
                                                    Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="Auto" />
                            <DataGridTextColumn Header="Aggiornamento"
                                                Binding="{Binding Title}"
                                                IsReadOnly="True"
                                                Width="3*" />
                            <DataGridTextColumn Header="Provider"
                                                Binding="{Binding Provider}"
                                                IsReadOnly="True"
                                                Width="*" />
                            <DataGridTextColumn Header="Modello"
                                                Binding="{Binding Model}"
                                                IsReadOnly="True"
                                                Width="*" />
                            <DataGridTextColumn Header="Classe"
                                                Binding="{Binding DriverClass}"
                                                IsReadOnly="True"
                                                Width="*" />
                            <DataGridTextColumn Header="Data driver"
                                                Binding="{Binding DriverDateText}"
                                                IsReadOnly="True"
                                                Width="Auto" />
                            <DataGridTextColumn Header="Dimensione"
                                                Binding="{Binding SizeText}"
                                                IsReadOnly="True"
                                                Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Provider OEM">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,10">
                        <TextBlock Text="Provider OEM ufficiali"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   Text="Windows Update resta la fonte automatica integrata. L'app rileva Intel, NVIDIA, AMD e anche il produttore del PC (Dell, Lenovo, HP, ASUS, Acer, Surface), usando solo flussi ufficiali." />
                    </StackPanel>

                    <DataGrid x:Name="OemProvidersGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding OemProviders}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Provider"
                                                Binding="{Binding DisplayName}"
                                                Width="*" />
                            <DataGridTextColumn Header="Dispositivi rilevati"
                                                Binding="{Binding DetectedDeviceCount}"
                                                Width="Auto" />
                            <DataGridTextColumn Header="Integrazione"
                                                Binding="{Binding IntegrationMode}"
                                                Width="*" />
                            <DataGridTextColumn Header="Companion"
                                                Binding="{Binding CompanionStatus}"
                                                Width="*" />
                            <DataGridTextColumn Header="Stato"
                                                Binding="{Binding Message}"
                                                Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                Margin="0,10,0,0">
                        <Button x:Name="RefreshOemProvidersButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="Aggiorna provider OEM"
                                Click="RefreshOemProvidersButton_Click" />
                        <Button x:Name="OpenSelectedOemProviderButton"
                                Style="{StaticResource PrimaryButton}"
                                Content="Apri supporto ufficiale"
                                Click="OpenSelectedOemProviderButton_Click" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="#64748B"
                                   Text="I companion e i portali OEM restano gestiti dai rispettivi produttori ufficiali." />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Diagnostica">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0"
                               Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal">
                            <Button x:Name="RefreshDiagnosticsButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Aggiorna diagnostica"
                                    Click="RefreshDiagnosticsButton_Click" />
                            <Button x:Name="CopyDiagnosticsButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Copia log"
                                    Click="CopyDiagnosticsButton_Click" />
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Servizio privilegiato"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Ultime informazioni e fino a 200 righe del log corrente."
                                       Foreground="#64748B"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <WrapPanel Grid.Row="1"
                               Margin="0,0,0,10">
                        <TextBlock Margin="0,0,20,0">
                            <Run Text="Versione: " FontWeight="SemiBold" />
                            <Run x:Name="ServiceVersionText" Text="—" />
                        </TextBlock>
                        <TextBlock Margin="0,0,20,0">
                            <Run Text="Avviato: " FontWeight="SemiBold" />
                            <Run x:Name="ServiceStartedText" Text="—" />
                        </TextBlock>
                        <TextBlock>
                            <Run Text="Log: " FontWeight="SemiBold" />
                            <Run x:Name="ServiceLogPathText" Text="—" />
                        </TextBlock>
                    </WrapPanel>

                    <TextBox x:Name="DiagnosticsLogTextBox"
                             Grid.Row="2"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             FontSize="12"
                             Background="#0F172A"
                             Foreground="#E2E8F0"
                             BorderThickness="0"
                             Padding="12"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Text="Nessun dato diagnostico caricato." />
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="4"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,14,0,0">
            <StackPanel>
                <TextBlock x:Name="StatusText"
                           Text="Pronto."
                           Foreground="#334155"
                           Margin="0,0,0,7" />
                <ProgressBar x:Name="OperationProgress"
                             Minimum="0"
                             Maximum="100"
                             Height="8"
                             Value="0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
