<Window x:Class="TheEasyWayForDrivers.Desktop.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Benvenuto in OmegaDrive"
        Icon="Assets/App.ico"
        Width="640"
        Height="520"
        MinWidth="420"
        MinHeight="340"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#111827"
                CornerRadius="14"
                Padding="22"
                Margin="0,0,0,18">
            <DockPanel>
                <Image Source="Assets/App.ico"
                       Width="72"
                       Height="72"
                       DockPanel.Dock="Left"
                       Margin="0,0,18,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="OmegaDrive"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Driver Manager"
                               Foreground="#60A5FA"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,3,0,0" />
                    <TextBlock Text="Drivers. Done right."
                               Foreground="#D1D5DB"
                               Margin="0,5,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- The preferences may exceed the available height at large DPI.
             Keep the confirmation button in the fixed footer, not here. -->
        <ScrollViewer Grid.Row="1"
                      x:Name="FirstRunOptionsScrollViewer"
                      AutomationProperties.Name="Opzioni della prima configurazione"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Prima configurazione"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#0F172A" />
            <TextBlock Text="OmegaDrive non installa driver automaticamente. Sei sempre tu a scegliere cosa installare."
                       Foreground="#475569"
                       TextWrapping="Wrap"
                       Margin="0,5,0,18" />

            <Border Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18">
                <StackPanel>
                    <CheckBox x:Name="StartWithWindowsCheckBox"
                              IsChecked="True"
                              Content="Avvia OmegaDrive con Windows"
                              FontWeight="SemiBold"
                              Margin="0,0,0,8" />
                    <TextBlock Text="Mantiene disponibile il controllo driver e le notifiche nell'area di sistema."
                               Foreground="#64748B"
                               Margin="24,0,0,16"
                               TextWrapping="Wrap" />

                    <CheckBox x:Name="ShowNotificationsCheckBox"
                              IsChecked="True"
                              Content="Mostra notifiche per nuovi aggiornamenti"
                              FontWeight="SemiBold"
                              Margin="0,0,0,8" />
                    <TextBlock Text="Le notifiche non avviano installazioni."
                               Foreground="#64748B"
                               Margin="24,0,0,16" />

                    <CheckBox x:Name="CheckOnStartupCheckBox"
                              IsChecked="False"
                              Content="Controlla driver e aggiornamenti all'avvio"
                              FontWeight="SemiBold"
                              Margin="0,0,0,8" />
                    <TextBlock Text="Può richiedere alcuni secondi e interroga Windows Update. È disattivato per impostazione predefinita."
                               Foreground="#64748B"
                               Margin="24,0,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Two rows avoid collisions between footer help and the CTA
             when the user shrinks the dialog or enlarges Windows text. -->
        <Grid Grid.Row="2" Margin="0,14,0,0"
              x:Name="FirstRunFooter">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Text="Puoi cambiare tutto in Impostazioni."
                       TextWrapping="Wrap"
                       Foreground="#64748B" />
            <Button Grid.Row="1"
                    HorizontalAlignment="Right"
                    MinWidth="205"
                    Margin="0,10,0,0"
                    Content="Inizia con OmegaDrive"
                    AutomationProperties.Name="Conferma le impostazioni iniziali e continua"
                    Padding="18,9"
                    Background="#0F6CBD"
                    Foreground="White"
                    BorderBrush="#0F6CBD"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="ContinueButton_Click" />
        </Grid>
    </Grid>
</Window>
