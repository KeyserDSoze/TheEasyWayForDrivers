<Window x:Class="TheEasyWayForDrivers.Desktop.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Benvenuto in OmegaDrive"
        Icon="Assets/App.ico"
        Width="680"
        Height="570"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#111827"
                CornerRadius="14"
                Padding="22"
                Margin="0,0,0,18">
            <DockPanel>
                <Image Source="Assets/App.ico"
                       Width="72"
                       Height="72"
                       DockPanel.Dock="Left"
                       Margin="0,0,18,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="OmegaDrive"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Driver Manager"
                               Foreground="#60A5FA"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,3,0,0" />
                    <TextBlock Text="Drivers. Done right."
                               Foreground="#D1D5DB"
                               Margin="0,5,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Prima configurazione"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#0F172A" />
            <TextBlock Text="OmegaDrive non installa driver automaticamente. Sei sempre tu a scegliere cosa installare."
                       Foreground="#475569"
                       TextWrapping="Wrap"
                       Margin="0,5,0,18" />

            <Border Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18">
                <StackPanel>
                    <CheckBox x:Name="StartWithWindowsCheckBox"
                              IsChecked="True"
                              Content="Avvia OmegaDrive con Windows"
                              FontWeight="SemiBold"
                              Margin="0,0,0,8" />
                    <TextBlock Text="Mantiene disponibile il controllo driver e le notifiche nell'area di sistema."
                               Foreground="#64748B"
                               Margin="24,0,0,16"
                               TextWrapping="Wrap" />

                    <CheckBox x:Name="ShowNotificationsCheckBox"
                              IsChecked="True"
                              Content="Mostra notifiche per nuovi aggiornamenti"
                              FontWeight="SemiBold"
                              Margin="0,0,0,8" />
                    <TextBlock Text="Le notifiche non avviano installazioni."
                               Foreground="#64748B"
                               Margin="24,0,0,16" />

                    <CheckBox x:Name="CheckOnStartupCheckBox"
                              IsChecked="False"
                              Content="Controlla driver e aggiornamenti all'avvio"
                              FontWeight="SemiBold"
                              Margin="0,0,0,8" />
                    <TextBlock Text="Può richiedere alcuni secondi e interroga Windows Update. È disattivato per impostazione predefinita."
                               Foreground="#64748B"
                               Margin="24,0,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>

        <DockPanel Grid.Row="2"
                   Margin="0,18,0,0">
            <TextBlock Text="Puoi cambiare tutto in Impostazioni."
                       Foreground="#64748B"
                       VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right"
                    Content="Inizia con OmegaDrive"
                    Padding="18,9"
                    Background="#0F6CBD"
                    Foreground="White"
                    BorderBrush="#0F6CBD"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="ContinueButton_Click" />
        </DockPanel>
    </Grid>
</Window>
